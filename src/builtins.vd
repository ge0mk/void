import std/core;
import std/list;
import std/io;
import std/string;

import ir;
import irbuilder;

func createTypeAlias(ctx: &&Context, ns: NamespaceRef, name: String, target: TypeRef) => void {
	discard ctx.createType(ns, name, TypeBody::Alias(target));
}

func createVoidType(ctx: &&Context, ns: NamespaceRef) => TypeRef {
	return ctx.createType(ns, "void", TypeBody::Void);
}

func createNeverType(ctx: &&Context, ns: NamespaceRef) => TypeRef {
	return ctx.createType(ns, "never", TypeBody::Void);
}

func createTypeRefType(ctx: &&Context, ns: NamespaceRef) => TypeRef {
	var type = ctx.createType(ns, "typeref", TypeBody::TypeRef);
	type.is_comptime = true;
	ctx.createBasicFunctions(type);
	ctx.createComparisonOperators(type, OpCode::UCmp);
	return type;
}

func createFuncRefType(ctx: &&Context, ns: NamespaceRef) => TypeRef {
	var type = ctx.createType(ns, "funcref", TypeBody::FuncRef);
	type.is_comptime = true;
	ctx.createBasicFunctions(type);
	ctx.createComparisonOperators(type, OpCode::UCmp);
	return type;
}

func createBoolType(ctx: &&Context, ns: NamespaceRef) => TypeRef {
	var type = ctx.createType(ns, "bool", TypeBody::Bool);
	ctx.createBasicFunctions(type);

	type.op_equal = ctx.createInlineFunction!<2u>(type.linked_namespace, "==", [type, type], type, OpCode::UCmp, ComparisonOp::EQ as u32, type);
	discard ctx.createInlineFunction!<2u>(type.linked_namespace, "!=", [type, type], type, OpCode::UCmp, ComparisonOp::NE as u32, type);

	discard ctx.createInlineFunction!<2u>(type.linked_namespace, "&", [type, type], type, OpCode::IntOp, IntOp::And as u32, type);
	discard ctx.createInlineFunction!<2u>(type.linked_namespace, "|", [type, type], type, OpCode::IntOp, IntOp::Or as u32, type);
	discard ctx.createInlineFunction!<2u>(type.linked_namespace, "^", [type, type], type, OpCode::IntOp, IntOp::XOr as u32, type);
	discard ctx.createInlineFunction!<1u>(type.linked_namespace, "!", [type], type, OpCode::IntOp, IntOp::Not as u32, type);
	discard ctx.createInlineFunction!<1u>(type.linked_namespace, "~", [type], type, OpCode::IntOp, IntOp::Not as u32, type);

	discard ctx.createInlineFunction!<2u>(type.linked_namespace, "&=", [type.varRef(), type], ctx.void_type, OpCode::IntRMWOp, IntOp::And as u32, type);
	discard ctx.createInlineFunction!<2u>(type.linked_namespace, "|=", [type.varRef(), type], ctx.void_type, OpCode::IntRMWOp, IntOp::Or as u32, type);
	discard ctx.createInlineFunction!<2u>(type.linked_namespace, "^=", [type.varRef(), type], ctx.void_type, OpCode::IntRMWOp, IntOp::XOr as u32, type);

	return type;
}

func createByteType(ctx: &&Context, ns: NamespaceRef) => TypeRef {
	var type = ctx.createType(ns, "byte", TypeBody::Byte);
	ctx.createBasicFunctions(type);
	ctx.createComparisonOperators(type, OpCode::UCmp);
	ctx.createBitwiseOperators(type, false);
	return type;
}

func createErrorType(ctx: &&Context, ns: NamespaceRef, id_type: TypeRef) => TypeRef {
	var type = ctx.createType(ns, "Error", TypeBody::Enum);
	type.id_type = id_type;
	type.addContainedType(id_type);
	ctx.createBasicFunctions(type);
	return type;
}

func createIntTypeTemplate(ctx: &&Context, ns: NamespaceRef) => TypeRef {
	var template_parameters: List!<TemplateParameterDecl>;
	template_parameters.append(TemplateParameterDecl("Size", ctx.uint_concept, false));
	template_parameters.append(TemplateParameterDecl("Signed", ctx.bool_concept, false));
	return ctx.createType(ns, "int", template_parameters, TypeBody::Int((size: 0u, is_signed: false)));
}

func createIntType(ctx: &&Context, ns: NamespaceRef, size: uint, is_signed: bool) => TypeRef {
	var template_parameters: List!<TemplateParameterDecl>;
	template_parameters.append(TemplateParameterDecl("Size", ctx.uint_concept, false, Value::fromPrimitive!<int>(size as int, ctx.int_type)));
	template_parameters.append(TemplateParameterDecl("Signed", ctx.bool_concept, false, Value::fromPrimitive!<bool>(is_signed, ctx.bool_type)));
	var type = ctx.createType(ns, "int", template_parameters, TypeBody::Int((size: size, is_signed: is_signed)));

	if ctx.int_type.isNull() && size == 0 && is_signed {
		ctx.int_type = type;
		type.template_parameters[0u].value.type = type;
	}

	ctx.createBasicFunctions(type);
	ctx.createComparisonOperators(type, is_signed ? OpCode::SCmp : OpCode::UCmp);
	ctx.createIntArithmeticOperators(type, is_signed);
	ctx.createBitwiseOperators(type, is_signed);

	return type;
}

func createFloatType(ctx: &&Context, ns: NamespaceRef, float_type: FloatType) => TypeRef {
	var type = ctx.createType(ns, format(float_type), List!<TemplateParameterDecl>(), TypeBody::Float(float_type));

	ctx.createBasicFunctions(type);
	ctx.createComparisonOperators(type, OpCode::FCmp);
	ctx.createFloatArithmeticOperators(type);

	return type;
}

func createPtrTypeTemplate(ctx: &&Context, ns: NamespaceRef) => TypeRef {
	var template_parameters: List!<TemplateParameterDecl>;
	template_parameters.append(TemplateParameterDecl("Pointee", ctx.any_concept, false));
	template_parameters.append(TemplateParameterDecl("Mutable", ctx.bool_concept, false));
	return ctx.createType(ns, "ptr", template_parameters, TypeBody::Pointer((pointee_type: TypeRef::null(), is_mutable: false)));
}

func createPtrType(ctx: &&Context, ns: NamespaceRef, pointee_type: TypeRef, is_mutable: bool) => TypeRef {
	var template_parameters: List!<TemplateParameterDecl>;
	template_parameters.append(TemplateParameterDecl("Pointee", ctx.any_concept, false, Value::TypeRef(pointee_type, ctx.typeref_type)));
	template_parameters.append(TemplateParameterDecl("Mutable", ctx.bool_concept, false, Value::fromPrimitive!<bool>(is_mutable, ctx.bool_type)));
	var type = ctx.createType(ns, "ptr", template_parameters, TypeBody::Pointer((pointee_type: pointee_type, is_mutable: is_mutable)));

	ctx.createBasicFunctions(type);
	ctx.createComparisonOperators(type, OpCode::UCmp);

	return type;
}
