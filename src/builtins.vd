func createPrimitiveCastTemplates(ctx: &&Context, ns: NamespaceRef) => void {
	var template_parameters = List!<TemplateParameterDecl>();
	template_parameters.append(TemplateParameterDecl("From", ctx.any_concept, false));
	template_parameters.append(TemplateParameterDecl("To", ctx.any_concept, false));

	discard ctx.createInlineFunction(ns, "intCast", template_parameters, OpCode::CastOp, 0u32, TypeRef::null());
	discard ctx.createInlineFunction(ns, "floatCast", template_parameters, OpCode::CastOp, 0u32, TypeRef::null());
	discard ctx.createInlineFunction(ns, "intToFloat", template_parameters, OpCode::CastOp, 0u32, TypeRef::null());
	discard ctx.createInlineFunction(ns, "floatToInt", template_parameters, OpCode::CastOp, 0u32, TypeRef::null());
	discard ctx.createInlineFunction(ns, "bitCast", template_parameters, OpCode::CastOp, 0u32, TypeRef::null());
	discard ctx.createInlineFunction(ns, "pointerCast", template_parameters, OpCode::CastOp, 0u32, TypeRef::null());
}

func createPrimitiveCastInstance(ctx: &&Context, ns: NamespaceRef, name: String, from: TypeRef, to: TypeRef) => FuncRef {
	var template_parameters = List!<TemplateParameterDecl>();
	template_parameters.append(TemplateParameterDecl("From", ctx.any_concept, false, Value::TypeRef(from, ctx.typeref_type)));
	template_parameters.append(TemplateParameterDecl("To", ctx.any_concept, false, Value::TypeRef(to, ctx.typeref_type)));
	const parameter_types = List!<TypeRef>(1u, from);
	var cast = CastOp::None;

	if name == "intCast" {
		if from.getSizeInBits() > to.getSizeInBits() {
			cast = Trunc;
		} else if from.getSizeInBits() == to.getSizeInBits() {
			cast = None;
		} else if from.isSigned() && to.isSigned() {
			cast = SExt;
		} else {
			cast = ZExt;
		}
	} else if name == "floatCast" {
		if from.getSizeInBits() > to.getSizeInBits() {
			cast = FTrunc;
		} else if from.getSizeInBits() == to.getSizeInBits() {
			cast = None;
		} else {
			cast = FExt;
		}
	} else if name == "intToFloat" {
		if from.isSigned() {
			cast = SIToF;
		} else {
			cast = UIToF;
		}
	} else if name == "floatToInt" {
		if to.isSigned() {
			cast = FToSI;
		} else {
			cast = FToUI;
		}
	} else if name == "bitCast" {
		cast = Bitcast;
	} else if name == "pointerCast" {
		cast = None;
	} else {
		panic("invalid primitive cast name: " + name);
	}

	return ctx.createInlineFunction(ns, name, template_parameters, parameter_types, to, OpCode::CastOp, cast as u32, from);
}

func createCoreReflectionFunctionTemplates(ctx: &&Context, ns: NamespaceRef) => void {
	const template_parameters = List!<TemplateParameterDecl>(1u, TemplateParameterDecl("TypeRef", ctx.any_concept, false));
	discard ctx.createInlineFunction(ns, "sizeOf", template_parameters, OpCode::SizeOf, 0u32, TypeRef::null());
	discard ctx.createInlineFunction(ns, "alignmentOf", template_parameters, OpCode::AlignmentOf, 0u32, TypeRef::null());
	discard ctx.createInlineFunction(ns, "referenceKindOf", template_parameters, OpCode::ReferenceKindOf, 0u32, TypeRef::null());
	discard ctx.createInlineFunction(ns, "hasDefaultConstructor", template_parameters, OpCode::HasDefaultConstructor, 0u32, TypeRef::null());
	discard ctx.createInlineFunction(ns, "hasCopyConstructor", template_parameters, OpCode::HasCopyConstructor, 0u32, TypeRef::null());
	discard ctx.createInlineFunction(ns, "hasAssignmentOperator", template_parameters, OpCode::HasAssignmentOperator, 0u32, TypeRef::null());
	discard ctx.createInlineFunction(ns, "hasEqualOperator", template_parameters, OpCode::HasEqualOperator, 0u32, TypeRef::null());
	discard ctx.createInlineFunction(ns, "hasCompareOperator", template_parameters, OpCode::HasCompareOperator, 0u32, TypeRef::null());
}

func createBasicFunctions(ctx: &&Context, type: TypeRef) => void {
	type.default_constructor = ctx.createInlineFunction!<1u>(type.linked_namespace, "constructor", [type.varRef()], ctx.void_type, OpCode::StoreNull, 0u32, type);
	type.copy_constructor = ctx.createInlineFunction!<2u>(type.linked_namespace, "constructor", [type.varRef(), type], ctx.void_type, OpCode::Store, 0u32, type);
	type.destructor = ctx.createInlineFunction!<1u>(type.linked_namespace, "destructor", [type.varRef()], ctx.void_type, OpCode::None, 0u32, type);
	type.op_assign = ctx.createInlineFunction!<2u>(type.linked_namespace, "=", [type.varRef(), type], ctx.void_type, OpCode::Store, 0u32, type);
}

func createComparisonOperators(ctx: &&Context, type: TypeRef, op: OpCode) => void {
	type.op_equal = ctx.createInlineFunction!<2u>(type.linked_namespace, "==", [type, type], ctx.bool_type, op, ComparisonOp::EQ as u32, type);
	discard ctx.createInlineFunction!<2u>(type.linked_namespace, "!=", [type, type], ctx.bool_type, op, ComparisonOp::NE as u32, type);
	discard ctx.createInlineFunction!<2u>(type.linked_namespace, "<", [type, type], ctx.bool_type, op, ComparisonOp::LT as u32, type);
	discard ctx.createInlineFunction!<2u>(type.linked_namespace, "<=", [type, type], ctx.bool_type, op, ComparisonOp::LE as u32, type);
	discard ctx.createInlineFunction!<2u>(type.linked_namespace, ">", [type, type], ctx.bool_type, op, ComparisonOp::GT as u32, type);
	discard ctx.createInlineFunction!<2u>(type.linked_namespace, ">=", [type, type], ctx.bool_type, op, ComparisonOp::GE as u32, type);
	type.op_compare = ctx.createInlineFunction!<2u>(type.linked_namespace, "<=>", [type, type], ctx.int_type, op, ComparisonOp::Cmp as u32, type);
}

func createIntArithmeticOperators(ctx: &&Context, type: TypeRef, signed: bool) => void {
	if signed {
		discard ctx.createInlineFunction!<1u>(type.linked_namespace, "-", [type], type, OpCode::IntOp, IntOp::Neg as u32, type);
	}

	discard ctx.createInlineFunction!<2u>(type.linked_namespace, "+", [type, type], type, OpCode::IntOp, IntOp::Add as u32, type);
	discard ctx.createInlineFunction!<2u>(type.linked_namespace, "-", [type, type], type, OpCode::IntOp, IntOp::Sub as u32, type);
	discard ctx.createInlineFunction!<2u>(type.linked_namespace, "*", [type, type], type, OpCode::IntOp, IntOp::Mul as u32, type);

	if signed {
		discard ctx.createInlineFunction!<2u>(type.linked_namespace, "/", [type, type], type, OpCode::IntOp, IntOp::Div as u32, type);
		discard ctx.createInlineFunction!<2u>(type.linked_namespace, "%", [type, type], type, OpCode::IntOp, IntOp::Mod as u32, type);
	} else {
		discard ctx.createInlineFunction!<2u>(type.linked_namespace, "/", [type, type], type, OpCode::IntOp, IntOp::UDiv as u32, type);
		discard ctx.createInlineFunction!<2u>(type.linked_namespace, "%", [type, type], type, OpCode::IntOp, IntOp::UMod as u32, type);
	}

	discard ctx.createInlineFunction!<2u>(type.linked_namespace, "+=", [type.varRef(), type], ctx.void_type, OpCode::IntRMWOp, IntOp::Add as u32, type);
	discard ctx.createInlineFunction!<2u>(type.linked_namespace, "-=", [type.varRef(), type], ctx.void_type, OpCode::IntRMWOp, IntOp::Sub as u32, type);
	discard ctx.createInlineFunction!<2u>(type.linked_namespace, "*=", [type.varRef(), type], ctx.void_type, OpCode::IntRMWOp, IntOp::Mul as u32, type);

	if signed {
		discard ctx.createInlineFunction!<2u>(type.linked_namespace, "/=", [type.varRef(), type], ctx.void_type, OpCode::IntRMWOp, IntOp::Div as u32, type);
		discard ctx.createInlineFunction!<2u>(type.linked_namespace, "%=", [type.varRef(), type], ctx.void_type, OpCode::IntRMWOp, IntOp::Mod as u32, type);
	} else {
		discard ctx.createInlineFunction!<2u>(type.linked_namespace, "/=", [type.varRef(), type], ctx.void_type, OpCode::IntRMWOp, IntOp::UDiv as u32, type);
		discard ctx.createInlineFunction!<2u>(type.linked_namespace, "%=", [type.varRef(), type], ctx.void_type, OpCode::IntRMWOp, IntOp::UMod as u32, type);
	}

	discard ctx.createInlineFunction!<1u>(type.linked_namespace, "++", [type.varRef()], ctx.void_type, OpCode::IntRMWOp, IntOp::Inc as u32, type);
	discard ctx.createInlineFunction!<1u>(type.linked_namespace, "--", [type.varRef()], ctx.void_type, OpCode::IntRMWOp, IntOp::Dec as u32, type);
}

func createFloatArithmeticOperators(ctx: &&Context, type: TypeRef) => void {
	discard ctx.createInlineFunction!<1u>(type.linked_namespace, "-", [type], type, OpCode::FloatOp, FloatOp::Neg as u32, type);
	discard ctx.createInlineFunction!<2u>(type.linked_namespace, "+", [type, type], type, OpCode::FloatOp, FloatOp::Add as u32, type);
	discard ctx.createInlineFunction!<2u>(type.linked_namespace, "-", [type, type], type, OpCode::FloatOp, FloatOp::Sub as u32, type);
	discard ctx.createInlineFunction!<2u>(type.linked_namespace, "*", [type, type], type, OpCode::FloatOp, FloatOp::Mul as u32, type);
	discard ctx.createInlineFunction!<2u>(type.linked_namespace, "/", [type, type], type, OpCode::FloatOp, FloatOp::Div as u32, type);
	discard ctx.createInlineFunction!<2u>(type.linked_namespace, "%", [type, type], type, OpCode::FloatOp, FloatOp::Mod as u32, type);

	discard ctx.createInlineFunction!<2u>(type.linked_namespace, "+=", [type.varRef(), type], ctx.void_type, OpCode::FloatRMWOp, FloatOp::Add as u32, type);
	discard ctx.createInlineFunction!<2u>(type.linked_namespace, "-=", [type.varRef(), type], ctx.void_type, OpCode::FloatRMWOp, FloatOp::Sub as u32, type);
	discard ctx.createInlineFunction!<2u>(type.linked_namespace, "*=", [type.varRef(), type], ctx.void_type, OpCode::FloatRMWOp, FloatOp::Mul as u32, type);
	discard ctx.createInlineFunction!<2u>(type.linked_namespace, "/=", [type.varRef(), type], ctx.void_type, OpCode::FloatRMWOp, FloatOp::Div as u32, type);
	discard ctx.createInlineFunction!<2u>(type.linked_namespace, "%=", [type.varRef(), type], ctx.void_type, OpCode::FloatRMWOp, FloatOp::Mod as u32, type);
}

func createBitwiseOperators(ctx: &&Context, type: TypeRef, signed: bool) => void {
	discard ctx.createInlineFunction!<1u>(type.linked_namespace, "~", [type], type, OpCode::IntOp, IntOp::Not as u32, type);
	discard ctx.createInlineFunction!<2u>(type.linked_namespace, "&", [type, type], type, OpCode::IntOp, IntOp::And as u32, type);
	discard ctx.createInlineFunction!<2u>(type.linked_namespace, "|", [type, type], type, OpCode::IntOp, IntOp::Or as u32, type);
	discard ctx.createInlineFunction!<2u>(type.linked_namespace, "^", [type, type], type, OpCode::IntOp, IntOp::XOr as u32, type);
	discard ctx.createInlineFunction!<2u>(type.linked_namespace, "<<", [type, type], type, OpCode::IntOp, IntOp::ShL as u32, type);
	discard ctx.createInlineFunction!<2u>(type.linked_namespace, ">>", [type, type], type, OpCode::IntOp, (signed ? IntOp::AShR : IntOp::LShR) as u32, type);

	discard ctx.createInlineFunction!<2u>(type.linked_namespace, "&=", [type.varRef(), type], ctx.void_type, OpCode::IntRMWOp, IntOp::And as u32, type);
	discard ctx.createInlineFunction!<2u>(type.linked_namespace, "|=", [type.varRef(), type], ctx.void_type, OpCode::IntRMWOp, IntOp::Or as u32, type);
	discard ctx.createInlineFunction!<2u>(type.linked_namespace, "^=", [type.varRef(), type], ctx.void_type, OpCode::IntRMWOp, IntOp::XOr as u32, type);
	discard ctx.createInlineFunction!<2u>(type.linked_namespace, "<<=", [type.varRef(), type], ctx.void_type, OpCode::IntRMWOp, IntOp::ShL as u32, type);
	discard ctx.createInlineFunction!<2u>(type.linked_namespace, ">>=", [type.varRef(), type], ctx.void_type, OpCode::IntRMWOp, (signed ? IntOp::AShR : IntOp::LShR) as u32, type);
}

func createDefaultVariantFunctions(ctx: &&Context, type: TypeRef) => void {
	var ns = type.linked_namespace;

	type.copy_constructor = ctx.createBuiltinFunction!<2u>(ns, "constructor", [type.varRef(), type], ctx.void_type, BuiltinFunctionBody::VariantCopyConstructor);
	type.destructor = ctx.createBuiltinFunction!<1u>(ns, "destructor", [type.varRef()], ctx.void_type, BuiltinFunctionBody::VariantDestructor);
	type.op_assign = ctx.createBuiltinFunction!<2u>(ns, "=", [type.varRef(), type], ctx.void_type, BuiltinFunctionBody::VariantOpAssign);
	type.op_equal = ctx.createBuiltinFunction!<2u>(ns, "==", [type, type], ctx.bool_type, BuiltinFunctionBody::VariantOpEqual);

	ns.addUncheckedFunctionBody(type.copy_constructor);
	ns.addUncheckedFunctionBody(type.destructor);
	ns.addUncheckedFunctionBody(type.op_assign);
	ns.addUncheckedFunctionBody(type.op_equal);

	for c in type.case_decls {
		ctx.createVariantCaseConstructor(type, c);
		ctx.createVariantOpIs(type, c);

		if c.type != ctx.void_type {
			ctx.createVariantOpUnsafeAs(type, ReferenceKind::Const, c);
			ctx.createVariantOpUnsafeAs(type, ReferenceKind::Var, c);
		}
	}
}

func createVariantCaseConstructor(ctx: &&Context, type: TypeRef, c: CaseRef) => void {
	var ns = type.linked_namespace;
	const template_parameters = List!<TemplateParameterDecl>(1u, TemplateParameterDecl("Id", ctx.int_concept, false, Value::fromPrimitive!<int>(c.id, ctx.int_type)));

	var parameter_types: List!<TypeRef>;
	parameter_types.append(type.varRef());

	if c.type != ctx.void_type {
		parameter_types.append(c.type);
	}

	for p in type.properties {
		parameter_types.append(p.type);
	}

	const f = ctx.createBuiltinFunction(ns, "constructor", template_parameters, parameter_types, ctx.void_type, BuiltinFunctionBody::VariantCaseConstructor);
	ns.addUncheckedFunctionBody(f);
}

func createVariantOpIs(ctx: &&Context, type: TypeRef, c: CaseRef) => void {
	const template_parameters = List!<TemplateParameterDecl>(1u, TemplateParameterDecl("Id", ctx.int_concept, false, Value::fromPrimitive!<int>(c.id, ctx.int_type)));
	const parameter_types = List!<TypeRef>(1u, type);
	discard ctx.createInlineFunction(type.linked_namespace, "is", template_parameters, parameter_types, ctx.bool_type, OpCode::VariantOpIs, 0u32, type);
}

func createVariantOpUnsafeAs(ctx: &&Context, type: TypeRef, reference_kind: ReferenceKind, c: CaseRef) => void {
	const template_parameters = List!<TemplateParameterDecl>(1u, TemplateParameterDecl("Id", ctx.int_concept, false, Value::fromPrimitive!<int>(c.id, ctx.int_type)));
	const parameter_types = List!<TypeRef>(1u, type.withReferenceKind(reference_kind));
	var result_type = c.type;
	if result_type.reference_kind == None {
		result_type.reference_kind = reference_kind;
	}
	discard ctx.createInlineFunction(type.linked_namespace, "unsafeAs", template_parameters, parameter_types, result_type, OpCode::VariantOpUnsafeAs, 0u32, type);
}
