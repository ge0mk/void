struct TSWasmEngine {}

struct TSWasmStore {}

enum TSWasmErrorKind {
	case TSWasmErrorKindNone = 0;
	case TSWasmErrorKindParse;
	case TSWasmErrorKindCompile;
	case TSWasmErrorKindInstantiate;
	case TSWasmErrorKindAllocate;
}

struct TSWasmError {
	var kind: TSWasmErrorKind;
	var message: ptr!<byte, true>;

	func constructor(this: &&TSWasmError, other: TSWasmError) => void = default;
	func destructor(this: &&TSWasmError) => void = default;
	func =(this: &&TSWasmError, other: TSWasmError) => void = default;
	func ==(this: TSWasmError, other: TSWasmError) => bool = default;
}

