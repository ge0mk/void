	case ForStmt = 113;
	case BreakStmt = 114;
	case ContinueStmt = 115;
	case YieldStmt = 116;
	case ReturnStmt = 117;
	case ThrowStmt = 118;
	case DeferStmt = 119;
	case ExprStmt = 120;
	case Decl = 121;
	case StructDecl = 122;
	case EnumDecl = 123;
	case VariantDecl = 124;
	case NamespaceDecl = 125;
	case TypeAlias = 126;
	case FunctionDecl = 127;
