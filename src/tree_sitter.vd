import std/core;

struct TSLanguage {}

func tree_sitter_void() => ptr!<TSLanguage, false> = extern;

alias TSStateId = u16;
alias TSSymbol = u16;
alias TSFieldId = u16;

struct TSParser {}

struct TSTree {}

struct TSQuery {}

struct TSQueryCursor {}

struct TSLookaheadIterator {}

enum TSInputEncoding {
	case TSInputEncodingUTF8;
	case TSInputEncodingUTF16;
}

enum TSSymbolType {
	case TSSymbolTypeRegular;
	case TSSymbolTypeAnonymous;
	case TSSymbolTypeAuxiliary;
}

struct TSPoint {
	var row: u32;
	var column: u32;

	func constructor(this: &&TSPoint, other: TSPoint) => void = default;
	func destructor(this: &&TSPoint) => void = default;
	func =(this: &&TSPoint, other: TSPoint) => void = default;
	func ==(this: TSPoint, other: TSPoint) => bool = default;
}

struct TSRange {
	var start_point: TSPoint;
	var end_point: TSPoint;
	var start_byte: u32;
	var end_byte: u32;

	func constructor(this: &&TSRange, other: TSRange) => void = default;
	func destructor(this: &&TSRange) => void = default;
	func =(this: &&TSRange, other: TSRange) => void = default;
	func ==(this: TSRange, other: TSRange) => bool = default;
}

struct TSInput {
	var payload: ptr!<byte, true>;
	var read: (ptr!<byte, true>, u32, TSPoint, ptr!<u32, true>) => ptr!<byte, false>;
	var encoding: TSInputEncoding;

	func constructor(this: &&TSInput, other: TSInput) => void = default;
	func destructor(this: &&TSInput) => void = default;
	func =(this: &&TSInput, other: TSInput) => void = default;
	func ==(this: TSInput, other: TSInput) => bool = default;
}

enum TSLogType {
	case TSLogTypeParse;
	case TSLogTypeLex;
}

struct TSLogger {
	var payload: ptr!<byte, true>;
	var log: (ptr!<byte, true>, TSLogType, ptr!<byte, false>) => void;

	func constructor(this: &&TSLogger, other: TSLogger) => void = default;
	func destructor(this: &&TSLogger) => void = default;
	func =(this: &&TSLogger, other: TSLogger) => void = default;
	func ==(this: TSLogger, other: TSLogger) => bool = default;
}

struct TSInputEdit {
	var start_byte: u32;
	var old_end_byte: u32;
	var new_end_byte: u32;
	var start_point: TSPoint;
	var old_end_point: TSPoint;
	var new_end_point: TSPoint;

	func constructor(this: &&TSInputEdit, other: TSInputEdit) => void = default;
	func destructor(this: &&TSInputEdit) => void = default;
	func =(this: &&TSInputEdit, other: TSInputEdit) => void = default;
	func ==(this: TSInputEdit, other: TSInputEdit) => bool = default;
}

struct TSNode {
	var context: Array!<u32, 4>;
	var id: ptr!<byte, false>;
	var tree: ptr!<TSTree, false>;

	func constructor(this: &&TSNode) => void = default;
	func constructor(this: &&TSNode, other: TSNode) => void = default;
	func destructor(this: &&TSNode) => void = default;
	func =(this: &&TSNode, other: TSNode) => void = default;
	func ==(this: TSNode, other: TSNode) => bool = default;
}

struct TSTreeCursor {
	var tree: ptr!<byte, false>;
	var id: ptr!<byte, false>;
	var context: Array!<u32, 3>;

	func constructor(this: &&TSTreeCursor, other: TSTreeCursor) => void = default;
	func destructor(this: &&TSTreeCursor) => void = default;
	func =(this: &&TSTreeCursor, other: TSTreeCursor) => void = default;
	func ==(this: TSTreeCursor, other: TSTreeCursor) => bool = default;
}

struct TSQueryCapture {
	var node: TSNode;
	var index: u32;

	func constructor(this: &&TSQueryCapture, other: TSQueryCapture) => void = default;
	func destructor(this: &&TSQueryCapture) => void = default;
	func =(this: &&TSQueryCapture, other: TSQueryCapture) => void = default;
	func ==(this: TSQueryCapture, other: TSQueryCapture) => bool = default;
}

enum TSQuantifier {
	case TSQuantifierZero = 0;
	case TSQuantifierZeroOrOne;
	case TSQuantifierZeroOrMore;
	case TSQuantifierOne;
	case TSQuantifierOneOrMore;
}

struct TSQueryMatch {
	var id: u32;
	var pattern_index: u16;
	var capture_count: u16;
	var captures: ptr!<TSQueryCapture, false>;

	func constructor(this: &&TSQueryMatch, other: TSQueryMatch) => void = default;
	func destructor(this: &&TSQueryMatch) => void = default;
	func =(this: &&TSQueryMatch, other: TSQueryMatch) => void = default;
	func ==(this: TSQueryMatch, other: TSQueryMatch) => bool = default;
}

enum TSQueryPredicateStepType {
	case TSQueryPredicateStepTypeDone;
	case TSQueryPredicateStepTypeCapture;
	case TSQueryPredicateStepTypeString;
}

struct TSQueryPredicateStep {
	var type: TSQueryPredicateStepType;
	var value_id: u32;

	func constructor(this: &&TSQueryPredicateStep, other: TSQueryPredicateStep) => void = default;
	func destructor(this: &&TSQueryPredicateStep) => void = default;
	func =(this: &&TSQueryPredicateStep, other: TSQueryPredicateStep) => void = default;
	func ==(this: TSQueryPredicateStep, other: TSQueryPredicateStep) => bool = default;
}

enum TSQueryError {
	case TSQueryErrorNone = 0;
	case TSQueryErrorSyntax;
	case TSQueryErrorNodeType;
	case TSQueryErrorField;
	case TSQueryErrorCapture;
	case TSQueryErrorStructure;
	case TSQueryErrorLanguage;
}

