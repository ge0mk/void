enum TSVoidField : u16 {
	case Attributes = 1;
	case BaseType = 2;
	case Body = 3;
	case Callee = 4;
	case Capture = 5;
	case CaptureKind = 6;
	case Comptime = 7;
	case Concept = 8;
	case Cond = 9;
	case Default = 10;
	case Discard = 11;
	case Else = 12;
	case Expr = 13;
	case Id = 14;
	case Initializer = 15;
	case IsVariadic = 16;
	case Key = 17;
	case Kind = 18;
	case Lhs = 19;
	case Name = 20;
	case Object = 21;
	case Op = 22;
	case Operand = 23;
	case ParameterTypes = 24;
	case Parameters = 25;
	case Postfix = 26;
	case Private = 27;
	case Range = 28;
	case ReturnType = 29;
	case Rhs = 30;
	case Signature = 31;
	case TemplateParameters = 32;
	case Then = 33;
	case Type = 34;
	case Value = 35;
}
