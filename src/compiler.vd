import std/core;
import std/box;
import std/file;
import std/format;
import std/io;
import std/libc/stdlib;
import std/list;
import std/map;
import std/math;
import std/set;
import std/shared;
import std/string;

import builtins;
import ir;
import irbuilder;
import irformatter;
import irinterpreter;
import irpasses;
import irtollvm;
import options;
import tree_sitter;

enum CallKind {
	case Static;
	case Operator;
	case MemberCall;
}

alias GlobalScope = (
	ns: NamespaceRef,
	function: FuncRef,
	builder: Builder,
	local_variables: List!<Map!<String, VariableRef>>,
	region_stack: List!<RegionRef>
);

struct Compiler {
	alias PragmaCallback = (&&Compiler, &&Context, NamespaceRef, Location) => void;

	var ctx: SharedPtr!<Context>;
	var options: CompilerOptions;
	var interpreter: Interpreter;
	var parser: ptr!<TSParser, true>;

	var modules_by_import_name: Map!<String, List!<NamespaceRef>>;
	var pragmas: List!<(name: String, callback: PragmaCallback)>;

	var global_scope_stack: List!<GlobalScope>;
	var current_target_state: NamespaceState;
	var current_namespace: NamespaceRef;
	var current_function: FuncRef;
	var builder: Builder;

	var local_variables: List!<Map!<String, VariableRef>>;
	var region_stack: List!<RegionRef>;
	var current_return_type: TypeRef;
	var active_properties: Set!<VariableRef>; // used to track (de-)initialized member variables in con/de-structors
	var return_variable: VariableRef;

	var current_loop: Value;
	var is_current_loop_comptime: bool;

	var current_match: uint;
	var match_value: uint;
	var match_type: TypeRef;
	var yield_type: TypeRef;
	var yield_var: VariableRef;

	var conversion_passes: Map!<OpCode, (&&Builder, Instruction) => void>;

	func constructor(this: &&Compiler, options: CompilerOptions) => void {
		this.ctx := createContext();
		this.ctx.hide_errors = options.hide_errors;
		this.options := options;
		this.interpreter := (&&this.ctx);
		this.parser := ts_parser_new();
		discard ts_parser_set_language(this.parser, tree_sitter_void());

		this.current_target_state := Unchecked;
		this.builder := (&&this.ctx, &&this.interpreter, FuncRef());

		for i in 0u..options.import_search_paths.size() {
			this.ctx.createTopLevelNamespace(format(i));
		}

		this.conversion_passes := ();

		this.conversion_passes.set(OpCode::Scope, func& inlineScopeOp(&&Builder, Instruction));
		this.conversion_passes.set(OpCode::IfElse, func& convertIfElseToBranch(&&Builder, Instruction));
		this.conversion_passes.set(OpCode::LoopWhile, func& convertWhileToBranch(&&Builder, Instruction));
		this.conversion_passes.set(OpCode::LoopDoWhile, func& convertWhileToBranch(&&Builder, Instruction));
		this.conversion_passes.set(OpCode::Break, func& convertBreakOrContinueToBranch(&&Builder, Instruction));
		this.conversion_passes.set(OpCode::Continue, func& convertBreakOrContinueToBranch(&&Builder, Instruction));
		this.conversion_passes.set(OpCode::Assert, func& convertAssertToCondBranch(&&Builder, Instruction));
		this.conversion_passes.set(OpCode::AssertError, func& convertAssertToCondBranch(&&Builder, Instruction));
	}

	func destructor(this: &&Compiler) => void {
		ts_parser_delete(this.parser);
	}

	func error(this: &&Compiler, msg: String, loc: Location) => void {
		this.ctx.error(msg, loc);

		if !this.current_function.isNull() {
			for p in this.current_function.template_parameters {
				this.ctx.info("    with " + p.signature(), Location());
			}
		}

		if !this.current_namespace.isNull() {
			for p in this.current_namespace.template_parameters {
				this.ctx.info("    with " + p.signature(), Location());
			}
		}

		if !this.current_function.isNull() {
			this.current_function.has_errors = true;
		} else if !this.current_namespace.isNull() {
			this.current_namespace.has_errors = true;
		}
	}

	func warn(this: &&Compiler, msg: String, loc: Location) => void {
		this.ctx.warn(msg, loc);
	}

	func info(this: &&Compiler, msg: String, loc: Location) => void {
		this.ctx.info(msg, loc);
	}

	func hint(this: &&Compiler, msg: String, loc: Location) => void {
		this.ctx.hint(msg, loc);
	}

	func todo(this: &&Compiler, msg: String, loc: Location) => void {
		this.ctx.todo(msg, loc);

		if !this.current_function.isNull() {
			this.current_function.has_errors = true;
		} else if !this.current_namespace.isNull() {
			this.current_namespace.has_errors = true;
		}
	}

	func expectType(this: &&Compiler, given: TypeRef, expected: TypeRef, loc: Location) => bool {
		if given.isNull() {
			return false;
		} else if given == expected {
			return true;
		} else {
			this.error("expression has type " + given.signature() + " but expected " + expected.signature(), loc);
			return false;
		}
	}

	func getNodeSpan(this: &&Compiler, node: &TSNode) => Location {
		if ts_node_is_null(node) || this.current_namespace.isNull() {
			return Location();
		}

		const start = ts_node_start_byte(node) as uint;
		const end = ts_node_end_byte(node) as uint;
		const module = this.current_namespace.module;

		var row = 0u32;
		var col = 0u32;
		for line in module.lines {
			if line.start <= start && line.end > start {
				row = line.row;
				col = (start - line.start) as u32;
			}
		}

		return Location(module, start, end, row, col);
	}

	func getNodeSource(this: &&Compiler, node: &TSNode) => String {
		if ts_node_is_null(node) || this.current_namespace.isNull() {
			return "";
		}

		const start = ts_node_start_byte(node) as uint;
		const end = ts_node_end_byte(node) as uint;
		return this.current_namespace.module.source.substring(start..end);
	}

	func getNodeChildren(this: &Compiler, node: &TSNode) => List!<TSNode> {
		var children: List!<TSNode>;
		children.grow(ts_node_named_child_count(node) as uint);
		for i in 0u32..ts_node_named_child_count(node) {
			children.append(ts_node_named_child(node, i));
		}
		return children;
	}

	func getBoolLiteral(this: &&Compiler, node: &TSNode) => bool {
		return ts_node_symbol(ts_node_child(node, 0u32)) as TSVoidSymbol == KeywordTrue;
	}

	func getNumberLiteral(this: &&Compiler, node: &TSNode) => (value: ParsedNumber, postfix: String) {
		const value = this.getNodeSource(ts_node_child_by_field_id(node, TSVoidField::Value as u16));
		const postfix = this.getNodeSource(ts_node_child_by_field_id(node, TSVoidField::Postfix as u16));
		println(value + postfix + " -> " + format(parseNumber(value, 0u).toInt()));
		return (value: parseNumber(value, 0u), postfix: postfix);
	}

	func getStringLiteral(this: &&Compiler, node: &TSNode) => (value: String, postfix: String) {
		const value = this.getNodeSource(ts_node_child_by_field_id(node, TSVoidField::Value as u16));
		const postfix = this.getNodeSource(ts_node_child_by_field_id(node, TSVoidField::Postfix as u16));
		// todo: parse escape sequences
		return (value: value, postfix: postfix);
	}

	func registerPragma(this: &&Compiler, name: String, callback: PragmaCallback) => void {
		this.pragmas.append((name: name, callback: callback));
	}

	func pushGlobalScope(this: &&Compiler, ns: NamespaceRef, function: FuncRef) => void {
		this.global_scope_stack.append(GlobalScope(this.current_namespace, this.current_function, this.builder, this.local_variables, this.region_stack));
		this.current_namespace = ns;
		this.current_function = function;
		this.builder = Builder(&&this.ctx, &&this.interpreter, function);
		this.local_variables.clear();
		this.region_stack.clear();
	}

	func popGlobalScope(this: &&Compiler) => void {
		const scope = this.global_scope_stack.takeLast();
		this.current_namespace = scope.ns;
		this.current_function = scope.function;
		this.builder = scope.builder;
		this.local_variables = scope.local_variables;
		this.region_stack = scope.region_stack;
	}

	func pushLocalScope(this: &&Compiler) => void {
		this.local_variables.append(Map!<String, VariableRef>());
	}

	func popLocalScope(this: &&Compiler) => void {
		this.local_variables.removeLast();
	}

	func run(this: &&Compiler) => int {
		const root_module = this.loadModule(ImportedModule(1u, this.options.root_module_path, this.options.program_name)) else: error {
			this.error("couldn't load module " + this.options.root_module_path + ": " + String::fromErrorCode(error), Location());
			return 1;
		}

		discard this.compile(root_module, NamespaceState::Done);
		var changes = false;
		do {
			changes = false;
			for ns in this.ctx.top_level_namespaces {
				changes |= this.compile(ns, NamespaceState::Done);
			}
		} while changes;

		if this.options.dump_ir {
			print(this.ctx.formatIR());
		}

		if this.options.mode == Compile {
			var converter: IRToLLVMConverter = (&&this.ctx, this.options);
			converter.run();
			converter.linkModule(this.options.install_path + "/rt.ll");
			converter.finalizeDI();
			converter.verify();

			const assembly_path = this.options.getOutputCodePath();
			match this.options.output_type {
				case LLVMAssembly -> converter.writeLLVMIRToFile(assembly_path);
				case LLVMBitcode -> converter.writeBitcodeToFile(assembly_path);
			}

			if this.ctx.has_errors {
				return 1;
			} else if this.options.codegen_only {
				return 0;
			}

			var clang_command = "clang " + assembly_path + " -o " + this.options.getOutputBinaryPath();
			clang_command += " -lc -lm";

			for lib in this.options.link_libraries {
				clang_command += " -l" + lib;
			}

			if this.options.symbol_type == None {
				clang_command += " -s";
			}

			if this.options.generate_debug_info {
				clang_command += " -g";
			}

			clang_command += " " + this.options.getOptimizationLevelAsClangArg();

			if !this.options.secondary_args.isEmpty() {
				clang_command += " " + " ".join(this.options.secondary_args);
			}

			clang_command += "\0";
			return system(clang_command.data()) as int;
		} else if this.options.mode == Check {
			return this.ctx.has_errors as int;
		} else if this.options.mode == Run {
			this.todo("interpret main", Location());
		}

		return this.ctx.has_errors as int;
	}

	func loadModule(this: &&Compiler, imported_module: ImportedModule) => Result!<NamespaceRef> {
		var file = try File::open(imported_module.path, OpenMode::read);
		var module = this.ctx.createModule(imported_module.group, imported_module.name, imported_module.path);
		module.source = try file.readAll();

		// collect line spans
		var line = 0u;
		var line_start = 0u;

		for index in 0u..module.source.size() {
			if module.source[index] == '\n'b {
				module.lines.append(Location(module, line_start, index, line as u32, 0u32));
				line++;
				line_start = index + 1;
			}
		}

		module.lines.append(Location(module, line_start, module.source.size(), line as u32, 0u32));

		var module_namespace = this.ctx.createModuleNamespace(module);

		module.ast = ts_parser_parse_string(this.parser, ptr!<TSTree, false>::null(), module.source.data(), module.source.size() as u32);
		const root = ts_tree_root_node(module.ast as ptr!<TSTree, false>);

		module_namespace.addUncheckedChildren(this.getNodeChildren(root));

		return Ok(module_namespace);
	}

	func compile(this: &&Compiler, ns: NamespaceRef, state: NamespaceState) => bool {
		if ns.state == IncompleteTemplate || ns.state >= state {
			return false;
		}

		const prev_target_state = this.current_target_state;
		this.pushGlobalScope(ns, FuncRef());

		while ns.state < state {
			this.current_target_state = ns.state + 1u;

			var changes = false;
			do {
				changes = false;
				for imported_namespace in ns.imported_namespaces {
					changes |= this.compile(imported_namespace, NamespaceState::UncheckedFunctionBodies);
				}

				var i = 0u;
				while i < ns.children.size() {
					changes |= this.compile(ns.children[i], this.current_target_state);
					i++;
				}
			} while changes;

			if !ns.linked_type.isNull() {
				for contained_type in ns.linked_type.getContainedTypes() {
					discard this.compile(contained_type.linked_namespace, ns.state);
				}
			}

			match ns.state {
				case IncompleteTemplate -> {}
				case Unchecked -> this.checkNamespaceBody(this.current_namespace);
				case UncheckedTypeBodies -> this.checkTypeBodies(this.current_namespace);
				case UncheckedFunctionSignatures -> this.checkFunctionSignatures(this.current_namespace);
				case UncheckedFunctionBodies -> this.checkFunctionBodies(this.current_namespace);
				case Done -> {}
			}
		}

		this.popGlobalScope();
		this.current_target_state = prev_target_state;
		return true;
	}

	func checkNamespaceBody(this: &&Compiler, ns: NamespaceRef) => void {
		while !ns.unchecked_children.isEmpty() {
			const children = ns.unchecked_children;
			ns.unchecked_children.clear();
			for child in children {
				discard this.compileStmt(child);
			}
		}

		if ns.state == Unchecked {
			ns.updateState(NamespaceState::UncheckedTypeBodies);
		}
	}

	func checkTypeBodies(this: &&Compiler, ns: NamespaceRef) => void {
		while !ns.unchecked_types.isEmpty() && ns.state == UncheckedTypeBodies {
			const types = ns.unchecked_types;
			ns.unchecked_types.clear();
			for type in types {
				this.checkTypeBody(type);
			}
		}

		if ns.state == UncheckedTypeBodies {
			ns.updateState(NamespaceState::UncheckedFunctionSignatures);
		}
	}

	func checkFunctionSignatures(this: &&Compiler, ns: NamespaceRef) => void {
		while !ns.unchecked_functions.isEmpty() && ns.state == UncheckedFunctionSignatures {
			const functions = ns.unchecked_functions;
			ns.unchecked_functions.clear();
			for function in functions {
				this.checkFunctionSignature(function);
			}
		}

		if ns.state == UncheckedFunctionSignatures {
			ns.updateState(NamespaceState::UncheckedFunctionBodies);
		}
	}

	func checkFunctionBodies(this: &&Compiler, ns: NamespaceRef) => void {
		while !ns.unchecked_function_bodies.isEmpty() && ns.state == UncheckedFunctionBodies {
			const functions = ns.unchecked_function_bodies;
			ns.unchecked_function_bodies.clear();
			for function in functions {
				this.checkFunctionBody(function);
			}
		}

		if ns.state == UncheckedFunctionBodies {
			ns.updateState(NamespaceState::Done);
		}
	}

	// check top level nodes
	func compileStmt(this: &&Compiler, node: &TSNode) => ControlFlowAction {
		const loc = this.getNodeSpan(node);
		match ts_node_symbol(node) as TSVoidSymbol {
			case Import -> {
				var segments: List!<String>;
				for i in 0u32..ts_node_named_child_count(node) {
					const child = ts_node_named_child(node, i);
					if ts_node_symbol(child) as TSVoidSymbol is Identifier {
						segments.append(this.getNodeSource(child));
					}
				}
				this.checkImport("/".join(segments), loc);
			}
			case Pragma -> {
				const name = this.getNodeSource(ts_node_named_child(node, 0u32));
				for p in this.pragmas {
					if p.name == name {
						p.callback(&&this, &&this.ctx, this.current_namespace, loc);
						return None;
					}
				}

				this.error("unknown pragma '" + name + "'", loc);
			}
			case Decl -> this.checkDecl(node, loc);
			case CompoundStmt -> return this.compileCompoundStmt(node, true, loc);
			case IfStmt -> return this.compileIfStmt(node, false, loc);
			case IfVarStmt -> return this.compileIfVarStmt(node, loc);
			case VarElseStmt -> return this.compileVarElseStmt(node, loc);
			case WhileStmt | DoWhileStmt -> return this.compileWhileStmt(node, loc);
			case ForStmt -> return this.compileForStmt(node, loc);
			case BreakStmt -> return this.compileBreakStmt(node, loc);
			case ContinueStmt -> return this.compileContinueStmt(node, loc);
			case YieldStmt -> return this.compileYieldStmt(node, loc);
			case ReturnStmt -> return this.compileReturnStmt(node, loc);
			case ThrowStmt -> return this.compileThrowStmt(node, loc);
			case DeferStmt -> return this.compileDeferStmt(node, loc);
			case ExprStmt -> return this.compileExprStmt(node, loc);
			case VariantCaseDecl -> this.checkCaseDecl(node, loc);
			case Comment -> {}
			default -> this.error("invalid node: " + String::fromCString(ts_node_type(node)), loc);
		}

		return None;
	}

	func checkImport(this: &&Compiler, import_name: String, loc: Location) => void {
		if import_name.isEmpty() {
			this.error("invalid import", loc);
			return;
		}

		var modules: List!<NamespaceRef>;

		if this.modules_by_import_name.contains(import_name) {
			modules = this.modules_by_import_name[import_name];
		} else {
			const imported_modules = this.options.getImportPaths(import_name);
			if imported_modules.isEmpty() {
				this.error("no matching module found", loc);
				return;
			}

			for imported_module in imported_modules {
				const module = this.ctx.getModuleNamespace(imported_module.path);
				if !module.isNull() {
					modules.append(module);
					continue;
				}

				match this.loadModule(imported_module) {
					case Ok: module -> {
						modules.append(module);
						discard this.compile(module, NamespaceState::UncheckedFunctionBodies);
					}
					case Error: error -> {
						this.error("couldn't load module " + imported_module.path + ": " + String::fromErrorCode(error), loc);
						continue;
					}
				}
			}

			this.modules_by_import_name[import_name] = modules;
		}

		for module in modules {
			this.current_namespace.addImportedNamespace(module);
		}
	}

	func checkDecl(this: &&Compiler, node: &TSNode, loc: Location) => void {
		const attributes = this.checkAttributeList(
			ts_node_child_by_field_id(node, TSVoidField::Attributes as u16)
		);
		const template_parameters = this.checkTemplateParameterDeclList(
			ts_node_child_by_field_id(node, TSVoidField::TemplateParameters as u16)
		);

		const is_private = !ts_node_is_null(ts_node_child_by_field_id(node, TSVoidField::Private as u16));

		const body = ts_node_child(node, ts_node_child_count(node) - 1);
		match ts_node_symbol(body) as TSVoidSymbol {
			case NamespaceDecl -> discard this.checkNamespaceDecl(body, attributes, template_parameters, is_private, loc);
			case StructDecl
			| EnumDecl
			| VariantDecl
			| TypeAlias -> discard this.checkTypeDecl(body, attributes, template_parameters, is_private, true, loc);
			case FunctionDecl -> discard this.checkFunctionDecl(body, attributes, template_parameters, is_private, true, loc);
			case VarDecl -> discard this.checkVarDecl(body, attributes, loc);
			default -> this.error("invalid decl", loc);
		}
	}

	func checkAttributeList(this: &&Compiler, node: &TSNode) => Map!<Attribute, Value> {
		var result: Map!<Attribute, Value>;
		if ts_node_is_null(node) {
			return result;
		}

		var attributes_by_name: Map!<String, Attribute>;
		attributes_by_name["packed"] = Packed;
		attributes_by_name["shallow"] = Shallow;
		attributes_by_name["extern_name"] = ExternName;

		result.grow(ts_node_named_child_count(node) as uint);
		for i in 0u32..ts_node_named_child_count(node) {
			const attribute_node = ts_node_named_child(node, i);
			const name = this.getNodeSource(ts_node_child_by_field_id(attribute_node, TSVoidField::Name as u16));
			const value_node = ts_node_child_by_field_id(attribute_node, TSVoidField::Value as u16);
			const kind = attributes_by_name.get(name) ?? Attribute::None;
			if ts_node_is_null(value_node) {
				result.set(kind, Value::Void(this.ctx.void_type));
			} else {
				const value = this.interpretComptimeExpr(value_node, TypeRef::null());
				result.set(kind, value);
			}
		}

		return result;
	}

	func checkTemplateParameterDeclList(this: &&Compiler, node: &TSNode) => List!<TemplateParameterDecl> {
		var result: List!<TemplateParameterDecl>;
		if !ts_node_is_null(node) {
			result.grow(ts_node_named_child_count(node) as uint);
			for i in 0u32..ts_node_named_child_count(node) {
				result.append(this.checkTemplateParameterDecl(ts_node_named_child(node, i)));
			}
		}
		return result;
	}

	func checkTemplateParameterDecl(this: &&Compiler, node: &TSNode) => TemplateParameterDecl {
		const loc = this.getNodeSpan(node);
		const name = this.getNodeSource(ts_node_child_by_field_id(node, TSVoidField::Name as u16));
		const concept_name = this.getNodeSource(ts_node_child_by_field_id(node, TSVoidField::Concept as u16));
		const concept = this.ctx.getConcept(concept_name);
		if concept.isNull() {
			this.error("unknown concept '" + concept_name + "'", loc);
			return TemplateParameterDecl();
		}

		const is_variadic = !ts_node_is_null(ts_node_child_by_field_id(node, TSVoidField::IsVariadic as u16));

		const value_node = ts_node_child_by_field_id(node, TSVoidField::Value as u16);
		if ts_node_is_null(value_node) {
			return TemplateParameterDecl(name, concept, is_variadic);
		}


		const value = this.interpretComptimeExpr(value_node, TypeRef::null());
		return TemplateParameterDecl(name, concept, is_variadic, value);
	}

	func checkNamespaceDecl(this: &&Compiler, node: TSNode, attributes: &Map!<Attribute, Value>, template_parameters: &List!<TemplateParameterDecl>, is_private: bool, loc: Location) => NamespaceRef {
		const name = this.getNodeSource(ts_node_child_by_field_id(node, TSVoidField::Name as u16));
		const body = ts_node_child_by_field_id(node, TSVoidField::Body as u16);

		var decl = this.ctx.getOrCreateChildNamespace(name, template_parameters, this.current_namespace, this.current_namespace.module);
		decl.attributes = attributes;
		decl.is_private = is_private;
		decl.addUncheckedChildren(this.getNodeChildren(body));
		return decl;
	}

	func checkTypeDecl(this: &&Compiler, node: TSNode, attributes: &Map!<Attribute, Value>, template_parameters: &List!<TemplateParameterDecl>, is_private: bool, add_to_unchecked_list: bool, loc: Location) => TypeRef {
		const name = this.getNodeSource(ts_node_child_by_field_id(node, TSVoidField::Name as u16));
		const name_span = this.getNodeSpan(ts_node_child_by_field_id(node, TSVoidField::Name as u16));

		for sibling in this.current_namespace.types_by_name[name] {
			if sibling.template_parameters == template_parameters {
				this.error("type redeclared with identical template parameters", name_span);
				this.info("previously declared here: ", sibling.name_span);
				return sibling;
			}
		}

		var type = this.ctx.createType(this.current_namespace, name, template_parameters, TypeBody::Empty);
		type.loc = loc;
		type.name_span = name_span;
		type.attributes = attributes;
		type.parsed_body = node;
		type.linked_namespace.is_private = is_private;
		if add_to_unchecked_list {
			this.current_namespace.addUncheckedType(type);
		}

		return type;
	}

	func checkFunctionDecl(this: &&Compiler, node: TSNode, attributes: &Map!<Attribute, Value>, template_parameters: &List!<TemplateParameterDecl>, is_private: bool, add_to_unchecked_list: bool, loc: Location) => FuncRef {
		const name = this.getNodeSource(ts_node_child_by_field_id(node, TSVoidField::Name as u16));
		const name_span = this.getNodeSpan(ts_node_child_by_field_id(node, TSVoidField::Name as u16));
		const signature_span = name_span..this.getNodeSpan(ts_node_child_by_field_id(node, TSVoidField::Signature as u16));
		const is_comptime = !ts_node_is_null(ts_node_child_by_field_id(node, TSVoidField::Comptime as u16));

		if !template_parameters.isEmpty() {
			for sibling in this.current_namespace.functions_by_name[name] {
				if sibling.template_parameters == template_parameters {
					this.error("function redeclared with identical template parameters", signature_span);
					this.info("previously declared here: ", sibling.signature_span);
					return sibling;
				}
			}
		}

		var function = this.ctx.createFunction(this.current_namespace, name, template_parameters);
		function.loc = loc;
		function.signature_span = signature_span;
		function.attributes = attributes;
		function.parsed_signature = ts_node_child_by_field_id(node, TSVoidField::Signature as u16);
		function.parsed_body = ts_node_child_by_field_id(node, TSVoidField::Body as u16);
		function.is_private = is_private;
		function.is_comptime |= is_comptime;

		if add_to_unchecked_list {
			this.current_namespace.addUncheckedFunction(function);
		}

		return function;
	}

	func checkTypeBody(this: &&Compiler, type: TypeRef) => void {
		if type.is_incomplete_template {
			return;
		}

		this.pushGlobalScope(type.linked_namespace, FuncRef());
		defer this.popGlobalScope();

		match ts_node_symbol(type.parsed_body) as TSVoidSymbol {
			case StructDecl -> type.body = Struct;
			case EnumDecl -> type.body = Enum;
			case VariantDecl -> type.body = Variant;
			case TypeAlias -> {
				const target = this.checkTypeUsage(ts_node_child_by_field_id(type.parsed_body, TSVoidField::Type as u16), false);
				type.body = Alias(target);
				discard this.compile(target.linked_namespace, NamespaceState::UncheckedFunctionSignatures);
				return;
			}
			default -> panic("invalid type body");
		}

		if type.body is Enum || type.body is Variant {
			if !ts_node_is_null(type.parsed_id_type) {
				type.id_type = this.checkTypeUsage(type.parsed_id_type, false);
			}

			if type.id_type.isNull() {
				type.id_type = this.ctx.int_type;
			}

			type.addContainedType(type.id_type);
		}

		const parsed_body = ts_node_child_by_field_id(type.parsed_body, TSVoidField::Body as u16);
		discard this.compileCompoundStmt(parsed_body, false, this.getNodeSpan(parsed_body));
		discard this.compile(type.linked_namespace, NamespaceState::UncheckedFunctionSignatures);

		match type.body {
			case Enum -> {
				type.copy_constructor = this.ctx.createInlineFunction!<2u>(type.linked_namespace, "constructor", [type.varRef(), type], this.ctx.void_type, OpCode::Store, 0u32, TypeRef::null());
				type.destructor = this.ctx.createInlineFunction!<1u>(type.linked_namespace, "destructor", [type.varRef()], this.ctx.void_type, OpCode::None, 0u32, TypeRef::null());
				type.op_assign = this.ctx.createInlineFunction!<2u>(type.linked_namespace, "=", [type.varRef(), type], this.ctx.void_type, OpCode::Store, 0u32, TypeRef::null());
				this.ctx.createComparisonOperators(type, OpCode::UCmp);
			}
			case Variant -> {
				this.ctx.createDefaultVariantFunctions(type);
			}
			default -> {}
		}
	}

	func checkFunctionSignature(this: &&Compiler, function: FuncRef) => void {
		if function.is_incomplete_template {
			return;
		}

		this.pushGlobalScope(function.parent_namespace, FuncRef());
		defer this.popGlobalScope();

		const parsed_return_type = ts_node_named_child(function.parsed_signature, ts_node_named_child_count(function.parsed_signature) - 1);
		function.setReturnType(this.checkTypeUsage(parsed_return_type, false));
		for i in 0u32..(ts_node_named_child_count(function.parsed_signature) - 1) {
			const parsed_parameter = ts_node_named_child(function.parsed_signature, i);
			const loc = this.getNodeSpan(parsed_parameter);
			const name = this.getNodeSource(ts_node_child_by_field_id(parsed_parameter, TSVoidField::Name as u16));
			const type = this.checkTypeUsage(ts_node_child_by_field_id(parsed_parameter, TSVoidField::Type as u16), false);

			const raw_index = function.appendParameterType(type);
			var parameter = this.ctx.createParameterVariable(function, name, type, raw_index, this.getNodeSpan(parsed_parameter));
			parameter.attributes = this.checkAttributeList(ts_node_child_by_field_id(parsed_parameter, TSVoidField::Attributes as u16));
		}

		if function.name != "" {
			for sibling in this.current_namespace.functions_by_name[function.name] {
				if sibling == function {
					continue;
				}

				if sibling.template_parameters != function.template_parameters {
					continue;
				}

				if sibling.parameter_types == function.parameter_types {
					this.error("function redeclared with identical parameter types", function.signature_span);
					this.info("previously declared here: ", sibling.signature_span);
				}
			}
		}

		if function.name == "main" {
			if !function.return_type.isNull() && function.return_type != this.ctx.int_type && function.return_type != this.ctx.void_type {
				this.error("invalid return type for main, expected " + this.ctx.int_type.signature() + " or " + this.ctx.void_type.signature(), function.signature_span);
			}

			// todo: validate parameter types

			if this.ctx.main_function.isNull() {
				this.ctx.main_function = function;
			} else {
				this.error("re-declaration of the main function", function.signature_span);
				this.hint("main was already declared here:", this.ctx.main_function.signature_span);
			}

			function.raw_parameter_types.clear();
			function.raw_parameter_types.append(this.ctx.ptr_type);
			function.raw_parameter_types.append(this.ctx.int_type);
			function.raw_return_type = this.ctx.int_type;
		}

		if !this.current_namespace.linked_type.isNull() {
			const type = this.current_namespace.linked_type;

			if function.name == "constructor" && function.parameter_types.size() == 1 {
				if function.parameter_types[0u] == type.varRef() {
					type.default_constructor = function;
				}
			} else if function.name == "constructor" && function.parameter_types.size() == 2 {
				if function.parameter_types[0u] == type.varRef() && function.parameter_types[1u] == type {
					type.copy_constructor = function;
					function.is_copy_constructor = true;

					// the "other" parameter in copy a constructor can't be deep copied (would result in recursion),
					// but it can safely be shallow copied because no other parameters can reference the same object
					function.parameters[1u].is_shallow_parameter = true;
				}
			} else if function.name == "destructor" && function.parameter_types.size() == 1 {
				if function.parameter_types[0u] == type.varRef() {
					type.destructor = function;
				}
			} else if function.name == "=" && function.parameter_types.size() == 2 {
				if function.parameter_types[0u] == type.varRef() && function.parameter_types[1u] == type {
					type.op_assign = function;
				}
			} else if function.name == "==" && function.parameter_types.size() == 2 {
				if function.parameter_types[0u] == type && function.parameter_types[1u] == type {
					type.op_equal = function;
				}
			} else if function.name == "<=>" && function.parameter_types.size() == 2 {
				if function.parameter_types[0u] == type && function.parameter_types[1u] == type {
					type.op_compare = function;
				}
			} else if function.name == "unwrap" && function.parameter_types.size() == 1 {
				if type.unwrapped_type.isNull() {
					type.unwrapped_type = function.return_type.base();
				} else if type.unwrapped_type != function.return_type.base() {
					this.error("unwrap() redeclared with different return type", function.signature_span);
				}

				if function.return_type.reference_kind < function.parameter_types[0u].reference_kind {
					this.error("invalid unwrap() declaration", function.signature_span);
				}
			}
		}

		this.current_namespace.addUncheckedFunctionBody(function);
	}

	func checkFunctionBody(this: &&Compiler, function: FuncRef) => void {
		if function.is_incomplete_template || function.is_inline {
			return;
		}

		if !ts_node_is_null(function.parsed_body) {
			match ts_node_symbol(function.parsed_body) as TSVoidSymbol {
				case DefaultFunctionBody -> this.createDefaultFunctionBody(function);
				case ExternFunctionBody -> function.is_extern = true;
				case CompoundStmt -> this.compileFunctionBody(function, function.parsed_body);
				default -> this.error("invalid function body", this.getNodeSpan(function.parsed_body));
			}
		}

		if function.is_builtin {
			this.validateBuiltinFunctionBody(function);
			this.compileBuiltinFunctionBody(function);
		}
	}

	func createDefaultFunctionBody(this: &&Compiler, function: FuncRef) => void {
		if function.parameter_types.isEmpty() {
			this.error("functions with a default body require at least one parameter", function.signature_span);
		}

		const p0 = function.parameter_types[0u];

		if function.name == "constructor" && p0.reference_kind == Var && p0.isStruct() && function.parameter_types.size() == 1 {
				function.setBody(BuiltinFunctionBody::StructDefaultConstructor);
		} else if function.name == "constructor" && p0.reference_kind == Var && p0.isStruct() && function.parameter_types.size() == 2 && function.parameter_types[1u] == p0.base() {
			function.setBody(BuiltinFunctionBody::StructCopyConstructor);
		} else if function.name == "destructor" && p0.reference_kind == Var && p0.isStruct() && function.parameter_types.size() == 1 {
			function.setBody(BuiltinFunctionBody::StructDestructor);
		} else if function.name == "=" && p0.reference_kind == Var && p0.isStruct() && function.parameter_types.size() == 2 && function.parameter_types[1u] == p0.base() {
			function.setBody(BuiltinFunctionBody::StructOpAssign);
		} else if function.name == "==" && p0.reference_kind == None && p0.isStruct() && function.parameter_types.size() == 2 && function.parameter_types[1u] == p0 {
			function.setBody(BuiltinFunctionBody::StructOpEqual);
		} else if function.name == "<=>" && p0.reference_kind == None && p0.isStruct() && function.parameter_types.size() == 2 && function.parameter_types[1u] == p0 {
			function.setBody(BuiltinFunctionBody::StructOpCmp);
		} else if function.name == "&" && p0.reference_kind == None && p0.isEnum() && function.parameter_types.size() == 2 && function.parameter_types[1u] == p0 {
			function.setBody(OpCode::IntOp, IntOp::And as u32, p0.id_type);
		} else if function.name == "|" && p0.reference_kind == None && p0.isEnum() && function.parameter_types.size() == 2 && function.parameter_types[1u] == p0 {
			function.setBody(OpCode::IntOp, IntOp::Or as u32, p0.id_type);
		} else if function.name == "&=" && p0.reference_kind == Var && p0.isEnum() && function.parameter_types.size() == 2 && function.parameter_types[1u] == p0.base() {
			function.setBody(OpCode::IntRMWOp, IntOp::And as u32, p0.id_type);
		} else if function.name == "|=" && p0.reference_kind == Var && p0.isEnum() && function.parameter_types.size() == 2 && function.parameter_types[1u] == p0.base() {
			function.setBody(OpCode::IntRMWOp, IntOp::Or as u32, p0.id_type);
		} else {
			this.error("can't generate default body for this function", function.signature_span);
		}
	}

	func validateBuiltinFunctionBody(this: &&Compiler, function: FuncRef) => void {
		const parent_type = function.parent_namespace.linked_type;

		for p in parent_type.properties {
			if p.type.isNull() || p.type.reference_kind != None {
				continue;
			}

			match function.builtin_body {
				case StructDefaultConstructor | ArrayDefaultConstructor -> {
					if p.type.default_constructor.isNull() {
						this.error(p.type.signature() + " is missing a default constructor", p.type.name_span);
						this.info("required by " + function.signature(), function.signature_span);
					}
				}
				case StructValueConstructor | StructCopyConstructor | VariantCaseConstructor | VariantCopyConstructor | ArrayCopyConstructor -> {
					if p.type.copy_constructor.isNull() {
						this.error(p.type.signature() + " is missing a copy constructor", p.type.name_span);
						this.info("required by " + function.signature(), function.signature_span);
					}
				}
				case StructDestructor | VariantDestructor | ArrayDestructor -> {
					if p.type.destructor.isNull() {
						this.error(p.type.signature() + " is missing a destructor", p.type.name_span);
						this.info("required by " + function.signature(), function.signature_span);
					}
				}
				case StructOpAssign | VariantOpAssign | ArrayOpAssign -> {
					if p.type.op_assign.isNull() {
						this.error(p.type.signature() + " is missing an assignment operator", p.type.name_span);
						this.info("required by " + function.signature(), function.signature_span);
					}
				}
				case StructOpEqual | VariantOpEqual | ArrayOpEqual -> {
					if p.type.op_equal.isNull() {
						this.error(p.type.signature() + " is missing an equal operator", p.type.name_span);
						this.info("required by " + function.signature(), function.signature_span);
					}
				}
				case StructOpCmp -> {
					if p.type.op_compare.isNull() {
						this.error(p.type.signature() + " is missing a compare operator", p.type.name_span);
						this.info("required by " + function.signature(), function.signature_span);
					}
				}
				default -> {}
			}
		}

		for c in parent_type.case_decls {
			if c.type == this.ctx.void_type || c.type == this.ctx.never_type || c.type.isNull() || c.type.reference_kind != None {
				continue;
			}

			match function.builtin_body {
				case VariantCaseConstructor -> {
					const id = function.template_parameters[0u].value.toInt();
					if id == c.id && c.type.copy_constructor.isNull() {
						this.error(c.type.signature() + " is missing a copy constructor", c.type.name_span);
						this.info("required by " + function.signature(), function.signature_span);
					}
				}
				case VariantCopyConstructor -> {
					if c.type.copy_constructor.isNull() {
						this.error(c.type.signature() + " is missing a copy constructor", c.type.name_span);
						this.info("required by " + function.signature(), function.signature_span);
					}
				}
				case VariantDestructor -> {
					if c.type.destructor.isNull() {
						this.error(c.type.signature() + " is missing a destructor", c.type.name_span);
						this.info("required by " + function.signature(), function.signature_span);
					}
				}
				case VariantOpAssign -> {
					if c.type.copy_constructor.isNull() {
						this.error(c.type.signature() + " is missing a copy constructor", c.type.name_span);
						this.info("required by " + function.signature(), function.signature_span);
					}

					if c.type.destructor.isNull() {
						this.error(c.type.signature() + " is missing a destructor", c.type.name_span);
						this.info("required by " + function.signature(), function.signature_span);
					}
				}
				case VariantOpEqual -> {
					if c.type.op_equal.isNull() {
						this.error(c.type.signature() + " is missing an equal operator", c.type.name_span);
						this.info("required by " + function.signature(), function.signature_span);
					}
				}
				default -> {}
			}
		}
	}

	func compileFunctionBody(this: &&Compiler, function: FuncRef, body: TSNode) => void {
		this.pushGlobalScope(function.parent_namespace, function);
		defer this.popGlobalScope();

		this.pushLocalScope();
		defer this.popLocalScope();

		this.region_stack.append(function.regions.front().getRef());
		defer this.region_stack.removeLast();

		var required_properties: Set!<VariableRef>;
		if !this.current_namespace.linked_type.isNull() {
			const parent_type = this.current_namespace.linked_type;

			if function.name == "constructor" {
				for member_variable in parent_type.properties {
					required_properties.add(member_variable);
				}
			} else {
				for member_variable in parent_type.properties {
					this.active_properties.add(member_variable);
				}
			}
		}

		if !function.return_type.isReturnedByValue() {
			function.result_addr = Value::Register(0u, function.return_type.varRef());
		}

		for parameter in function.parameters {
			if parameter.type.reference_kind != None {
				this.local_variables.back()[parameter.name] = parameter;
				continue;
			}

			const variable = this.createLocalVariable(parameter.name, parameter.type, false, false, parameter.loc);
			var constructor_parameters: List!<Value>;
			constructor_parameters.append(Value::Variable(variable, variable.type.varRef()));

			if parameter.type.isPrimitive() {
				constructor_parameters.append(Value::Register(parameter.raw_index, parameter.type));
			} else {
				this.todo("finish non-primitive parameter copy constructor parameters", parameter.loc);
			}

			discard this.compileCall(Name("constructor"), constructor_parameters, CallKind::MemberCall, false, parameter.loc);
			this.deferDestructorCall(variable);
		}

		discard this.compileCompoundStmt(function.parsed_body, false, this.getNodeSpan(function.parsed_body));

		// add constructor/destructor calls

		// add return stmt if entry region doesn't have a terminator
		if !function.regions.front().hasTerminator() {
			this.builder.setInsertPointToEnd(function.regions.front().blocks.back().getRef());
			if function.return_type == this.ctx.void_type {
				if function == this.ctx.main_function {
					discard this.builder.buildReturn(Value::fromPrimitive!<int>(0, this.ctx.int_type));
				} else {
					discard this.builder.buildReturn(Value::Void(this.ctx.void_type));
				}
			} else {
				this.error("function doesn't return a value in all paths", function.signature_span);
			}
		}

		this.builder.inlineDeferOps();
		this.builder.runConversionPasses(this.conversion_passes);
	}

	func getResultAddr(this: &&Compiler, function: FuncRef) => void {
		if function.return_type.isNull() || function.return_type.isPrimitive() {}
	}

	func compileBuiltinFunctionBody(this: &&Compiler, function: FuncRef) => void {
		this.todo("compile function body", function.signature_span);
	}

	func checkCaseDecl(this: &&Compiler, node: &TSNode, loc: Location) => void {
		if this.current_namespace.linked_type.isNull() {
			this.error("case declarations are only allowed inside enum or variant types", loc);
		}

		var type_decl = this.current_namespace.linked_type;
		if !(type_decl.body is Enum || type_decl.body is Variant) {
			this.error("case declarations are only allowed inside enum or variant types", loc);
			return;
		}

		const is_default_case = !ts_node_is_null(ts_node_child_by_field_id(node, TSVoidField::Default as u16));
		const name = this.getNodeSource(ts_node_child_by_field_id(node, TSVoidField::Name as u16));

		var type = TypeRef::null();
		const type_node = ts_node_child_by_field_id(node, TSVoidField::Type as u16);
		if !ts_node_is_null(type_node) {
			if type_decl.body is Enum {
				this.error("only variant cases are allowed to have a payload attached", loc);
			} else {
				type = this.checkTypeUsage(type_node, false);
			}
		}

		var id = type_decl.getNextCaseId();
		const id_node = ts_node_child_by_field_id(node, TSVoidField::Id as u16);
		if !ts_node_is_null(id_node) {
			const id_value = this.interpretComptimeExpr(id_node, type_decl.id_type);
			if !(id_value is Undefined) {
				id = id_value.toInt();
			}
		}

		discard this.ctx.createCase(type_decl, name, id, type, loc);
	}

	// symbol lookup functions
	func lookupNamespace(this: &&Compiler, namespaces_to_search: &Set!<NamespaceRef>, name: &NameSegment, loc: Location) => Set!<NamespaceRef> {
		var result: Set!<NamespaceRef>;

		for n in namespaces_to_search {
			var most_matching_template_parameters = 0;
			var matching_children: List!<NamespaceRef>;

			for child in n.children_by_name.getOrDefault(name.name) {
				const matching_template_parameters = this.getMatchingTemplateParameterCount(child.template_parameters, name.template_parameters);
				if matching_template_parameters > most_matching_template_parameters {
					matching_children.clear();
					matching_children.append(child);
					most_matching_template_parameters = matching_template_parameters;
				} else if matching_template_parameters == most_matching_template_parameters {
					matching_children.append(child);
				}
			}

			result.grow(result.size() + matching_children.size());
			for child in matching_children {
				if child.is_private && this.current_namespace != child.parent {
					continue;
				}

				if child.is_incomplete_template {
					child = this.createNamespaceTemplateInstance(child, name.template_parameters, loc);
				}

				if !child.linked_type.isNull() {
					if const target = child.linked_type.body as Alias {
						child = target.linked_namespace;
					}
				}

				result.add(child);
			}
		}

		return result;
	}

	func getNamespacesToSearch(this: &&Compiler, name: &Name, parent_type: TypeRef, loc: Location) => Set!<NamespaceRef> {
		var namespaces_to_search: Set!<NamespaceRef>;
		namespaces_to_search.grow(8u);

		if name.segments.size() == 1 {
			namespaces_to_search = this.current_namespace.visible_namespaces;
			if !parent_type.isNull() {
				namespaces_to_search.add(parent_type.linked_namespace);

				if !parent_type.unwrapped_type.isNull() {
					namespaces_to_search.add(parent_type.unwrapped_type.linked_namespace);
				}
			}
		} else {
			const name_segments: List!<NameSegment> = name.segments[0u..(name.segments.size() - 1)];
			for n in this.current_namespace.visible_namespaces {
				var matching_namespaces: Set!<NamespaceRef>;
				matching_namespaces.add(n);

				const intersecting_segments = n.full_name.intersection(name_segments);
				for i in intersecting_segments..name_segments.size() {
					matching_namespaces = this.lookupNamespace(matching_namespaces, name_segments[i], loc);
				}

				namespaces_to_search.add(matching_namespaces);
			}
		}

		return namespaces_to_search;
	}

	func getMatchingTemplateParameterCount(this: &&Compiler, template_decls: &List!<TemplateParameterDecl>, template_parameters: &List!<Value>) => int {
		if template_decls.size() == 0 {
			if template_parameters.size() == 0 {
				return 0;
			} else {
				return -1;
			}
		}

		const is_variadic = template_decls[template_decls.size() - 1].is_variadic;

		if template_parameters.size() < template_decls.size() {
			if !(is_variadic && template_parameters.size() == template_decls.size() - 1) {
				return -1;
			}
		} else if template_parameters.size() > template_decls.size() && !is_variadic {
			return -1;
		}

		var count = 0;
		for i in 0u..template_parameters.size() {
			const template_parameter_decl = &template_decls[min!<uint>(i, template_decls.size() - 1)];
			if !this.doesConceptAcceptTemplateParameter(template_parameter_decl.concept, template_parameters[i]) {
				return -1;
			}

			if template_parameter_decl.value is Undefined {
				continue;
			}

			if template_parameter_decl.value != template_parameters[i] {
				return -1;
			} else {
				count += 1;
			}
		}

		return count;
	}

	func doesConceptAcceptTemplateParameter(this: &&Compiler, concept: ConceptRef, parameter: &Value) => bool {
		if concept.isNull() {
			return false;
		}

		match concept.unwrap() {
			case Boolean -> return parameter.implicitlyDereferencedType() == this.ctx.bool_type;
			case Integer -> return parameter.implicitlyDereferencedType() == this.ctx.int_type;
			case String -> return parameter.implicitlyDereferencedType() == this.ctx.str_type;
			case Any -> return parameter is TypeRef;
		}
	}

	func lookupTemplateParameter(this: &&Compiler, name: String) => List!<Value> {
		var result: List!<Value>;

		if !this.current_function.isNull() {
			for template_parameter in this.current_function.template_parameters {
				if template_parameter.name == name && !(template_parameter.value is Undefined) {
					result.append(template_parameter.value);
				}
			}
		}

		var current_namespace = this.current_namespace;
		while !current_namespace.isNull() {
			for template_parameter in current_namespace.template_parameters {
				if template_parameter.name == name && !(template_parameter.value is Undefined) {
					result.append(template_parameter.value);
				}
			}

			current_namespace = current_namespace.parent;
		}

		return result;
	}

	func lookupTemplateParameter(this: &&Compiler, name: &Name) => List!<Value> {
		if name.segments.size() != 1 {
			return List!<Value>();
		}

		if !name.segments[0u].template_parameters.isEmpty() {
			return List!<Value>();
		}

		return this.lookupTemplateParameter(name.segments[0u].name);
	}

	func lookupType(this: &&Compiler, name: &Name, loc: Location) => List!<TypeRef> {
		return this.lookupType(name, this.getNamespacesToSearch(name, TypeRef(), loc), loc);
	}

	func lookupType(this: &&Compiler, name: &Name, namespaces_to_search: &Set!<NamespaceRef>, loc: Location) => List!<TypeRef> {
		const last_segment = name.segments[name.segments.size() - 1];
		const is_templated_name = last_segment.template_parameters.size() > 0;
		const is_namespaced_name = name.segments.size() > 1;

		var result: List!<TypeRef>;
		for n in this.lookupNamespace(namespaces_to_search, last_segment, loc) {
			if !n.linked_type.isNull() {
				result.append(TypeRef(n.linked_type));
			}
		}

		if !is_namespaced_name && !is_templated_name && namespaces_to_search.contains(this.ctx.core_namespace) {
			if const bits = getIntTypeBits(last_segment.name) {
				const is_signed = last_segment.name[0u] == 'i'b;
				var template_parameters: List!<Value>;
				template_parameters.append(Value::fromPrimitive!<int>(bits as int, this.ctx.int_type));
				template_parameters.append(Value::fromPrimitive!<bool>(is_signed, this.ctx.bool_type));

				for n in this.lookupNamespace(namespaces_to_search, NameSegment("int", template_parameters), loc) {
					if !n.linked_type.isNull() {
						result.append(TypeRef(n.linked_type));
					}
				}
			}
		}

		if !is_namespaced_name && !is_templated_name {
			for template_parameter in this.lookupTemplateParameter(last_segment.name) {
				match template_parameter {
					case TypeRef: type -> result.append(type);
					default -> {}
				}
			}
		}

		return result;
	}

	func getIntTypeBits(name: String) => Optional!<uint> {
		if name.size() <= 1 {
			return None;
		}

		if name[0u] != 'i'b && name[0u] != 'u'b {
			return None;
		}

		name = name.substring(1u..name.size());
		const number = parseNumber(name, 0u);
		if number.length < name.size() {
			return None;
		}

		return Some(number.toInt() as uint);
	}

	func lookupFunction(this: &&Compiler, name: &Name, parent_type: TypeRef, parameter_types: &List!<TypeRef>, allow_unwrapping_this: bool, allow_unwrapping: bool, loc: Location) => List!<FuncRef> {
		var candidates: List!<FuncRef>;

		const last_segment = name.segments[name.segments.size() - 1];
		for n in this.getNamespacesToSearch(name, parent_type, loc) {
			var most_matching_template_parameters = 0;
			var functions_with_matching_template_parameters: List!<FuncRef>;
			for function in n.functions_by_name.getOrDefault(last_segment.name) {
				const matching_template_parameters = this.getMatchingTemplateParameterCount(function.template_parameters, last_segment.template_parameters);

				if matching_template_parameters > most_matching_template_parameters {
					functions_with_matching_template_parameters.clear();
					functions_with_matching_template_parameters.append(function);
					most_matching_template_parameters = matching_template_parameters;
				} else if matching_template_parameters == most_matching_template_parameters {
					functions_with_matching_template_parameters.append(function);
				}
			}

			for function in functions_with_matching_template_parameters {
				if function.is_private && this.current_namespace != function.parent_namespace {
					continue;
				}

				if function.is_incomplete_template {
					candidates.append(this.createFunctionTemplateInstance(function, last_segment.template_parameters, loc));
				} else {
					candidates.append(function);
				}
			}
		}

		return this.selectMatchingFunctions(candidates, parameter_types, allow_unwrapping_this, allow_unwrapping);
	}

	func selectMatchingFunctions(this: &&Compiler, candidates: &List!<FuncRef>, parameter_types: &List!<TypeRef>, allow_unwrapping_this: bool, allow_unwrapping: bool) => List!<FuncRef> {
		var result: List!<FuncRef>;
		result.grow(4u);

		var most_matching_parameters = 0;
		for function in candidates {
			const matching_parameters = function.getMatchingParameterCount(parameter_types, allow_unwrapping_this, allow_unwrapping);

			if matching_parameters < most_matching_parameters {
				continue;
			} else if matching_parameters == 0 {
				result.append(function);
				continue;
			} else if matching_parameters > most_matching_parameters {
				result.clear();
				result.append(function);
				most_matching_parameters = matching_parameters;
				continue;
			}

			const ref_kind = function.parameter_types[0u].reference_kind;
			var inserted = false;

			for i in 0u..result.size() {
				if result[i].parameter_types[0u].reference_kind < ref_kind {
					result.insert(i, function);
					inserted = true;
					break;
				}
			}

			if !inserted {
				result.append(function);
			}
		}

		return result;
	}

	func getMatchingParameterCount(function: &FunctionDecl, parameter_types: &List!<TypeRef>, allow_unwrapping_this: bool, allow_unwrapping: bool) => int {
		if function.parameter_types.size() != parameter_types.size() {
			return -1;
		}

		var count = 0;
		for i in 0u..parameter_types.size() {
			const required_parameter_type = parameter_types[i];
			const function_parameter_type = function.parameter_types[i];

			if function_parameter_type.reference_kind > required_parameter_type.reference_kind {
				return -1;
			}

			if required_parameter_type.decl == function_parameter_type.decl {
				count++;
			} else if !((i != 0 && allow_unwrapping) || (i == 0 && allow_unwrapping_this)) {
				return -1;
			} else if required_parameter_type.unwrapped_type != function_parameter_type.base() {
				return -1;
			}
		}

		return count;
	}

	func validateFunctionCandidates(this: &&Compiler, candidates: &List!<FuncRef>, required_name: &Name, required_parameter_types: &List!<TypeRef>, loc: Location) => bool {
		if candidates.isEmpty() {
			this.error("no matching function found", loc);
			this.info("looking for " + format(required_name) + format(required_parameter_types), Location());
			return false;
		}

		var no_ref_count = 0;
		var const_ref_count = 0;
		var var_ref_count = 0;
		var no_param_count = 0;

		for f in candidates {
			if f.parameter_types.isEmpty() {
				no_param_count++;
				continue;
			}

			match f.parameter_types[0u].reference_kind {
				case None -> no_ref_count++;
				case Const -> const_ref_count++;
				case Var -> var_ref_count++;
			}
		}

		if no_ref_count > 1 || const_ref_count > 1 || var_ref_count > 1 || no_param_count > 1 {
			this.error("too many matching functions found", loc);
			this.info("candidates are:", Location());
			for f in candidates {
				this.info("    " + f.signature(), Location());
			}
			return false;
		}

		return true;
	}

	func lookupCaseDecl(this: &&Compiler, name: &Name, parent_type: TypeRef, loc: Location) => List!<CaseRef> {
		return this.lookupCaseDecl(name, this.getNamespacesToSearch(name, TypeRef(), loc), parent_type, loc);
	}

	func lookupCaseDecl(this: &&Compiler, name: &Name, namespaces_to_search: &Set!<NamespaceRef>, parent_type: TypeRef, loc: Location) => List!<CaseRef> {
		const last_segment = name.segments[name.segments.size() - 1];
		const is_namespaced_name = name.segments.size() > 1;
		var result: List!<CaseRef>;

		if last_segment.template_parameters.size() > 0 {
			return result;
		}

		if !is_namespaced_name && !parent_type.isNull() {
			if const c = parent_type.cases_by_name.get(last_segment.name) {
				result.append(c);
			}
		} else if is_namespaced_name {
			for n in namespaces_to_search {
				if n.linked_type.isNull() {
					continue;
				}

				if const c = n.linked_type.cases_by_name.get(last_segment.name) {
					result.append(c);
				}
			}
		}

		return result;
	}

	func lookupVariable(this: &&Compiler, name: &Name, loc: Location) => List!<VariableRef> {
		return this.lookupVariable(name, this.getNamespacesToSearch(name, TypeRef(), loc), loc);
	}

	func lookupVariable(this: &&Compiler, name: &Name, namespaces_to_search: &Set!<NamespaceRef>, loc: Location) => List!<VariableRef> {
		const last_segment = name.segments[name.segments.size() - 1];
		var result: List!<VariableRef>;

		if last_segment.template_parameters.size() > 0 {
			return result;
		}

		for n in namespaces_to_search {
			if const variable = n.variables_by_name.get(last_segment.name) {
				result.append(variable);
			}
		}

		if name.segments.size() == 1 {
			const variable = this.getLocalVariableByName(last_segment.name);
			if !variable.isNull() {
				result.append(variable);
			}
		}

		return result;
	}

	func getLocalVariableByName(this: &&Compiler, name: String) => VariableRef {
		for variables_by_name in this.local_variables {
			if const variable = variables_by_name.get(name) {
				return variable;
			}
		}

		return VariableRef::null();
	}

	// type lookup helper functions
	func getType(this: &&Compiler, name: &Name, loc: Location) => TypeRef {
		return this.getType(name, loc, false);
	}

	func getType(this: &&Compiler, name: &Name, loc: Location, quiet: bool) => TypeRef {
		if name.isEmpty() {
			return TypeRef::null();
		}

		const candidates = this.lookupType(name, loc);
		if candidates.isEmpty() {
			if !quiet {
				this.error("no matching type found", loc);
				this.info("looking for " + format(name), Location());
			}

			return TypeRef::null();
		} else if candidates.size() == 1 {
			return candidates[0u];
		} else {
			if !quiet {
				this.error("more than one matching types found", loc);
				this.info("looking for " + format(name), Location());
			}

			return TypeRef::null();
		}
	}

	func getVectorType(this: &&Compiler, element_type: TypeRef, size: uint, loc: Location) => TypeRef {
		var template_parameters: List!<Value>;
		template_parameters.append(Value::TypeRef(element_type, this.ctx.typeref_type));
		template_parameters.append(Value::fromPrimitive!<int>(size as int, this.ctx.int_type));
		return this.getType(Name("Vector", template_parameters), loc);
	}

	func getMatrixType(this: &&Compiler, element_type: TypeRef, columns: uint, rows: uint, loc: Location) => TypeRef {
		if rows == 1 {
			return this.getVectorType(element_type, columns, loc);
		} else if columns == 1 {
			return this.getVectorType(element_type, rows, loc);
		} else {
			var template_parameters: List!<Value>;
			template_parameters.append(Value::TypeRef(element_type, this.ctx.typeref_type));
			template_parameters.append(Value::fromPrimitive!<int>(columns as int, this.ctx.int_type));
			template_parameters.append(Value::fromPrimitive!<int>(rows as int, this.ctx.int_type));
			return this.getType(Name("Matrix", template_parameters), loc);
		}
	}

	func getFunctionType(this: &&Compiler, parameter_types: &List!<TypeRef>, return_type: TypeRef, loc: Location) => TypeRef {
		var template_parameters: List!<Value>;
		template_parameters.append(Value::TypeRef(return_type, this.ctx.typeref_type));
		for t in parameter_types {
			template_parameters.append(Value::TypeRef(t, this.ctx.typeref_type));
		}

		return this.getType(Name("function", template_parameters), loc);
	}

	// template instance creation
	func createNamespaceTemplateInstance(this: &&Compiler, base: NamespaceRef, template_parameters: &List!<Value>, error_span: Location) => NamespaceRef {
		if !base.linked_type.isNull() {
			const decl = this.createTypeTemplateInstance(base.linked_type, template_parameters, error_span);
			if !decl.isNull() {
				return decl.linked_namespace;
			} else {
				return NamespaceRef();
			}
		}

		var instance = this.ctx.getOrCreateChildNamespace(base.name, getTemplateParameterDecls(base.template_parameters, template_parameters), base.parent, base.parent.module);
		instance.is_incomplete_template = false;
		instance.addUncheckedChildren(base.unchecked_children);
		base.template_instances.append(instance);
		discard this.compile(instance, this.current_target_state);
		return instance;
	}

	func createTypeTemplateInstance(this: &&Compiler, base: TypeRef, template_parameters: &List!<Value>, error_span: Location) => TypeRef {
		var instance: TypeRef;
		match base.body {
			case Empty -> {
				instance = this.checkTypeDecl(
					base.parsed_body,
					base.attributes,
					getTemplateParameterDecls(base.template_parameters, template_parameters),
					base.linked_namespace.is_private,
					this.current_target_state <= UncheckedTypeBodies,
					error_span
				);

				if this.current_target_state > UncheckedTypeBodies {
					this.checkTypeBody(instance);
				}
			}
			case Int -> {
				const size = template_parameters[0u] is Undefined ? 0u : template_parameters[0u].toUInt();
				const is_signed = template_parameters[1u].toBool();
				instance = this.ctx.createIntType(base.parent_namespace, size, is_signed);
			}
			case Pointer -> {
				const pointee_type = template_parameters[0u].toType();
				const is_mutable = template_parameters[1u].toBool();
				instance = this.ctx.createPtrType(base.parent_namespace, pointee_type, is_mutable);
			}
			default -> {
				this.error("can't create template instance of type " + base.signature(), error_span);
				abort();
			}
		}

		instance.is_incomplete_template = false;
		instance.linked_namespace.addUncheckedChildren(base.linked_namespace.unchecked_children);
		base.linked_namespace.template_instances.append(instance.linked_namespace);
		discard this.compile(instance.linked_namespace, this.current_target_state);
		return instance;
	}

	template <P: uint>
	func createTypeTemplateInstance(this: &&Compiler, base: TypeRef, template_parameters: &Array!<Value, P>, error_span: Location) => TypeRef {
		return this.createTypeTemplateInstance(base, List!<Value>(template_parameters.range()), error_span);
	}

	func createFunctionTemplateInstance(this: &&Compiler, base: FuncRef, template_parameters: &List!<Value>, error_span: Location) => FuncRef {
		var instance: FuncRef;
		if base.is_inline {
			panic("todo: implement inline function template instance creation");
		} else if base.is_builtin {
			panic("todo: implement builtin function template instance creation");
		} else {
			panic("todo: implement function template instance creation");
		}
	}

	func getTemplateParameterDecls(template_parameters: List!<TemplateParameterDecl>, values: &List!<Value>) => List!<TemplateParameterDecl> {
		for i in 0u..values.size() {
			if template_parameters.size() <= i {
				template_parameters.append(template_parameters[i - 1]);
			}

			template_parameters[i].value = values[i];
		}

		return template_parameters;
	}

	// check & compile ast nodes
	func checkName(this: &&Compiler, node: &TSNode, quiet: bool) => Name {
		match ts_node_symbol(node) as TSVoidSymbol {
			case Name -> {
				const name = this.getNodeSource(ts_node_child_by_field_id(node, TSVoidField::Name as u16));
				var template_parameters: List!<Value>;
				for i in 1u32..ts_node_named_child_count(node) {
					const child = ts_node_named_child(node, i);
					const value = this.interpretComptimeExpr(child, TypeRef::null());
					template_parameters.append(value);
				}

				for p in template_parameters {
					if p is Undefined {
						return Name();
					}
				}

				return Name(this.getNodeSpan(node), name, template_parameters);
			}
			case NamespaceExpr -> {
				const lhs = this.checkName(ts_node_child_by_field_id(node, TSVoidField::Lhs as u16), quiet);
				const rhs = this.checkName(ts_node_child_by_field_id(node, TSVoidField::Rhs as u16), quiet);
				if lhs.isEmpty() || rhs.isEmpty() {
					return Name();
				}
				return lhs..rhs;
			}
			default -> {
				if !quiet {
					this.error("invalid name", this.getNodeSpan(node));
				}
				return Name();
			}
		}
	}

	func checkTypeUsage(this: &&Compiler, node: TSNode, quiet: bool) => TypeRef {
		match ts_node_symbol(node) as TSVoidSymbol {
			case Name | NamespaceExpr -> return this.getType(
				this.checkName(node, quiet),
				this.getNodeSpan(node),
				quiet
			);
			case PrefixExpr -> {
				const op = this.getNodeSource(ts_node_child_by_field_id(node, TSVoidField::Op as u16));
				const operand = ts_node_child_by_field_id(node, TSVoidField::Operand as u16);
				if op == "&" {
					return this.checkTypeUsage(operand, quiet).constRef();
				} else if op == "&&" {
					return this.checkTypeUsage(operand, quiet).varRef();
				}
			}
			default -> {}
		}

		if !quiet {
			this.error("invalid type", this.getNodeSpan(node));
		}
		return TypeRef::null();
	}

	func compileCompoundStmt(this: &&Compiler, node: &TSNode, create_scope: bool, loc: Location) => ControlFlowAction {
		this.pushLocalScope();

		const prev_block = this.builder.getInsertBlock();
		var region: RegionRef;
		if !this.current_function.isNull() && create_scope {
			region = this.current_function.createRegion();
			this.builder.setInsertPointToEnd(region);
		}

		var r = ControlFlowAction::None;
		for i in 0u32..ts_node_named_child_count(node) {
			r = this.compileStmt(ts_node_named_child(node, i));
			if r != None {
				break;
			}
		}

		if !this.current_function.isNull() && create_scope {
			this.builder.setInsertPointToEnd(prev_block);
			discard this.builder.buildScope(region);
		}

		this.popLocalScope();
		return r;
	}

	func checkVarDecl(this: &&Compiler, node: &TSNode, attributes: &Map!<Attribute, Value>, loc: Location) => VariableRef {
		const is_comptime = !ts_node_is_null(ts_node_child_by_field_id(node, TSVoidField::Comptime as u16));
		const is_const = this.getNodeSource(ts_node_child_by_field_id(node, TSVoidField::Kind as u16)) == "const";
		const name = this.getNodeSource(ts_node_child_by_field_id(node, TSVoidField::Name as u16));
		const type_node = ts_node_child_by_field_id(node, TSVoidField::Type as u16);
		const init_node = ts_node_child_by_field_id(node, TSVoidField::Initializer as u16);

		const prev_block = this.builder.getInsertBlock();
		const init_region = this.current_function.createRegion();
		this.builder.setInsertPointToEnd(init_region);

		var type = TypeRef::null();
		if !ts_node_is_null(type_node) {
			type = this.checkTypeUsage(type_node, false);
		}

		var initializer: List!<Value>;
		if !ts_node_is_null(init_node) {
			initializer.append(this.compileExpr(init_node, type));
		}

		if type.isNull() {
			type = initializer[0u].type;
		}

		const variable = this.createLocalVariable(name, type, is_const, is_comptime, loc);
		if type.reference_kind == None {
			initializer.insert(0u, Value::Variable(variable, type.varRef()));
			discard this.compileCall(Name("constructor"), initializer, CallKind::MemberCall, true, loc)
		} else {
			discard this.builder.buildStore(Value::Variable(variable, this.ctx.ptr_type), initializer[0u]);
		}

		this.builder.setInsertPointToEnd(prev_block);
		discard this.builder.buildScope(init_region);
		return variable;
	}

	func createLocalVariable(this: &&Compiler, name: String, type: TypeRef, is_const: bool, is_comptime: bool, loc: Location) => VariableRef {
		const decl = this.ctx.createLocalVariable(this.current_function, name, type, is_const, is_comptime, loc);
		this.local_variables.back()[decl.name] = decl;
		return decl;
	}

	func deferDestructorCall(this: &&Compiler, variable: VariableRef) => void {
		const destructor = variable.type.destructor;
		if destructor.isNull() {
			return;
		}

		if destructor.is_inline && destructor.inline_body.op == None {
			return;
		}

		this.todo("build defered destructor call", variable.loc);
	}

	func compileIfStmt(this: &&Compiler, node: &TSNode, is_comptime: bool, loc: Location) => ControlFlowAction {
		is_comptime |= !ts_node_is_null(ts_node_child_by_field_id(node, TSVoidField::Comptime as u16));
		const cond_node = ts_node_child_by_field_id(node, TSVoidField::Cond as u16);
		const then_node = ts_node_child_by_field_id(node, TSVoidField::Then as u16);
		const else_node = ts_node_child_by_field_id(node, TSVoidField::Else as u16);

		if is_comptime {
			const cond = this.compileComptimeExpr(cond_node, this.ctx.bool_type);
			if !this.expectType(cond.return_type, this.ctx.bool_type, this.getNodeSpan(cond_node)) {
				return None;
			}

			if this.interpretComptimeExpr(cond).toBool() {
				return this.compileStmt(then_node);
			} else if !ts_node_is_null(else_node) {
				return this.compileStmt(else_node);
			}
		} else {
			const cond = this.compileScopedExpr(cond_node, this.ctx.bool_type);
			const cond_value = this.builder.buildScope(cond.region, cond.value);
			discard this.expectType(cond.value.implicitlyDereferencedType(), this.ctx.bool_type, this.getNodeSpan(cond_node));

			const prev_active_properties = this.active_properties;

			const prev_block = this.builder.getInsertBlock();
			const then_region = this.current_function.createRegion();
			const else_region = this.current_function.createRegion();

			discard this.builder.buildIfElse(cond_value, then_region, else_region);

			this.builder.setInsertPointToEnd(then_region);
			discard this.compileCompoundStmt(then_node, false, this.getNodeSpan(then_node));
			const then_branch_active_properties = this.active_properties;

			this.active_properties = prev_active_properties;
			if !ts_node_is_null(else_node) {
				this.builder.setInsertPointToEnd(else_region);
				discard this.compileCompoundStmt(else_node, false, this.getNodeSpan(else_node));
			}

			if then_branch_active_properties != this.active_properties {
				this.error("if & then branch (de)initialize different member variables", loc);
			}

			this.builder.setInsertPointToEnd(prev_block);
		}

		return None;
	}

	func compileIfVarStmt(this: &&Compiler, node: &TSNode, loc: Location) => ControlFlowAction {
		this.todo("compile if-var stmts", loc);
		return None;
	}

	func compileVarElseStmt(this: &&Compiler, node: &TSNode, loc: Location) => ControlFlowAction {
		this.todo("compile var-else stmts", loc);
		return None;
	}

	func compileWhileStmt(this: &&Compiler, node: &TSNode, loc: Location) => ControlFlowAction {
		const is_comptime = !ts_node_is_null(ts_node_child_by_field_id(node, TSVoidField::Comptime as u16));
		const is_do_while = ts_node_symbol(node) as TSVoidSymbol == DoWhileStmt;
		const cond_node = ts_node_child_by_field_id(node, TSVoidField::Cond as u16);
		const body_node = ts_node_child_by_field_id(node, TSVoidField::Body as u16);

		if is_comptime {
			const prev_is_current_loop_comptime = this.is_current_loop_comptime;
			defer this.is_current_loop_comptime = prev_is_current_loop_comptime;
			this.is_current_loop_comptime = true;

			const cond = this.compileComptimeExpr(cond_node, this.ctx.bool_type);
			if !this.expectType(cond.return_type, this.ctx.bool_type, this.getNodeSpan(cond_node)) {
				return None;
			}

			if is_do_while {
				const r = this.compileStmt(body_node);
				match r {
					case None | Continue -> {}
					case Break -> return None;
					default -> return r;
				}
			}

			while this.interpretComptimeExpr(cond).toBool() {
				const r = this.compileStmt(body_node);
				match r {
					case None -> {}
					case Break -> return None;
					case Continue -> continue;
					default -> return r;
				}
			}
		} else {
			const cond = this.compileScopedExpr(cond_node, this.ctx.bool_type);
			discard this.expectType(cond.value.implicitlyDereferencedType(), this.ctx.bool_type, this.getNodeSpan(cond_node));

			const body = this.current_function.createRegion();
			const prev_loop = this.current_loop;
			this.current_loop = match is_do_while {
				case true -> yield this.builder.buildLoopDoWhile(cond.value, cond.region, body)
				case false -> yield this.builder.buildLoopWhile(cond.value, cond.region, body);
			};

			const prev_block = this.builder.getInsertBlock();
			this.builder.setInsertPointToEnd(body);
			discard this.compileStmt(body_node);
			this.builder.setInsertPointToEnd(prev_block);

			this.current_loop = prev_loop;
		}

		return None;
	}

	func compileForStmt(this: &&Compiler, node: &TSNode, loc: Location) => ControlFlowAction {
		this.todo("compile for stmts", loc);
		return None;
	}

	func compileBreakStmt(this: &&Compiler, node: &TSNode, loc: Location) => ControlFlowAction {
		if this.current_loop is Undefined {
			this.error("break statements must be inside of a loop", loc);
		} else if this.is_current_loop_comptime {
			return Break;
		} else {
			discard this.builder.buildBreak(this.current_loop);
		}

		return None;
	}

	func compileContinueStmt(this: &&Compiler, node: &TSNode, loc: Location) => ControlFlowAction {
		if this.current_loop is Undefined {
			this.error("continue statements must be inside of a loop", loc);
		} else if this.is_current_loop_comptime {
			return Continue;
		} else {
			discard this.builder.buildContinue(this.current_loop);
		}

		return None;
	}

	func compileYieldStmt(this: &&Compiler, node: &TSNode, loc: Location) => ControlFlowAction {
		this.todo("compile yield stmts", loc);
		return None;
	}

	func compileReturnStmt(this: &&Compiler, node: &TSNode, loc: Location) => ControlFlowAction {
		const value_node = ts_node_named_child(node, 0u32);
		if ts_node_is_null(value_node) {
			this.compileReturnStmt(Value::Void(this.ctx.void_type), loc);
		} else {
			const value = this.compileExpr(value_node, this.current_function.return_type);
			this.compileReturnStmt(value, loc);
		}
		return None;
	}

	func compileReturnStmt(this: &&Compiler, value: Value, loc: Location) => void {
		value = this.applyImplicitDereference(value);

		if value is Undefined {
			discard this.builder.buildReturn(Value::Undefined(this.current_function.return_type, false));
			return;
		}

		if value.type != this.current_function.return_type {
			this.error("invalid return type: expected " + this.current_function.return_type.signature() + ", but got " + value.implicitlyDereferencedType().signature(), loc);
			return;
		}

		if value.type.isPrimitive() {
			discard this.builder.buildReturn(value);
		} else {
			this.todo("compile return stmts with non-primitive type", loc);
		}
	}

	func compileThrowStmt(this: &&Compiler, node: &TSNode, loc: Location) => ControlFlowAction {
		this.todo("compile throw stmts", loc);
		return None;
	}

	func compileDeferStmt(this: &&Compiler, node: &TSNode, loc: Location) => ControlFlowAction {
		const prev_block = this.builder.getInsertBlock();

		const region = this.current_function.createRegion();
		this.builder.setInsertPointToEnd(region);
		discard this.compileStmt(ts_node_child(node, 0u32));

		this.builder.setInsertPointToEnd(prev_block);
		discard this.builder.buildDefer(region);
		return None;
	}

	func compileExprStmt(this: &&Compiler, node: &TSNode, loc: Location) => ControlFlowAction {
		const is_comptime = !ts_node_is_null(ts_node_child_by_field_id(node, TSVoidField::Comptime as u16));
		const is_discard_stmt = !ts_node_is_null(ts_node_child_by_field_id(node, TSVoidField::Discard as u16));
		const expr_node = ts_node_child_by_field_id(node, TSVoidField::Expr as u16);

		var result: Value;
		if is_comptime {
			result = this.interpretComptimeExpr(expr_node, this.ctx.void_type);
		} else {
			const expr = this.compileScopedExpr(expr_node, this.ctx.void_type);
			result = this.builder.buildScope(expr.region, expr.value);
		}

		if !is_discard_stmt && !(result is Undefined)
		&& result.implicitlyDereferencedType() != this.ctx.void_type
		&& result.implicitlyDereferencedType() != this.ctx.never_type {
			this.error("unused value", this.getNodeSpan(node));
		}

		return None;
	}

	func compileExpr(this: &&Compiler, node: &TSNode, expected_type: TypeRef) => Value {
		const loc = this.getNodeSpan(node);
		match ts_node_symbol(node) as TSVoidSymbol {
			case Name | NamespaceExpr -> return this.compileNameExpr(this.checkName(node, false), expected_type, loc);
			case Literal -> {
				const postfix = this.getNodeSource(ts_node_child_by_field_id(node, TSVoidField::Postfix as u16));
				const value_node = ts_node_child_by_field_id(node, TSVoidField::Value as u16);
				const value_source = this.getNodeSource(value_node);
				match ts_node_symbol(value_node) as TSVoidSymbol {
					case BoolLiteral -> {
						return this.compileBoolLiteralExpr(value_source == "true", expected_type, loc);
					}
					case NumberLiteral -> {
						const value = parseNumber(value_source, 0u);
						return this.compileNumberLiteralExpr(value, postfix, expected_type, loc);
					}
					case CharLiteral -> {
						const value = value_source.substring(1u..(value_source.size() - 1));
						return this.compileCharLiteralExpr(value, postfix, expected_type, loc);
					}
					case StringLiteral -> {
						const value = value_source.substring(1u..(value_source.size() - 1));
						return this.compileStringLiteralExpr(value, postfix, expected_type, loc);
					}
					default -> panic("invalid literal");
				}
			}
			case MemberAccessExpr -> return this.compileMemberAccessExpr(node, expected_type, loc);
			case CallExpr -> return this.compileCallExpr(node, loc);
			case IndexExpr -> return this.compileIndexExpr(node, loc);
			case PrefixExpr | PostfixExpr -> return this.compileUnaryExpr(node, expected_type, loc);
			case BinaryExpr -> return this.compileBinaryExpr(node, expected_type, loc);
			case InlineIfExpr -> return this.compileInlineIfExpr(node, expected_type, loc);
			case TupleExpr | NamedTupleExpr -> return this.compileTupleExpr(node, expected_type, loc);
			case ArrayExpr -> return this.compileArrayExpr(node, expected_type, loc);
			case DictExpr -> return this.compileDictExpr(node, expected_type, loc);
			case MatchExpr -> return this.compileMatchExpr(node, expected_type, loc);
			case AnonymousFunctionExpr -> return this.compileAnonymousFunctionExpr(node, loc);
			case FunctionReferenceExpr -> return this.compileFunctionReferenceExpr(node, loc);
			default -> {
				this.error("invalid expr", loc);
				return Undefined;
			}
		}
	}

	func compileNameExpr(this: &&Compiler, name: &Name, expected_type: TypeRef, loc: Location) => Value {
		if name.isEmpty() {
			return Undefined;
		}

		const namespaces_to_search = this.getNamespacesToSearch(name, TypeRef(), loc);

		const types = this.lookupType(name, namespaces_to_search, loc);
		const variables = this.lookupVariable(name, namespaces_to_search, loc);
		const case_decls = this.lookupCaseDecl(name, namespaces_to_search, expected_type, loc);
		const template_parameters = this.lookupTemplateParameter(name);

		const candidates = types.size() + variables.size() + case_decls.size() + template_parameters.size();
		if candidates == 0 {
			this.error("no matching symbol found for '" + format(name) + "'", name.loc);
			return Value::Undefined;
		} else if candidates > 1 {
			this.error("more than one matching symbol found for '" + format(name) + "'", name.loc);
			return Value::Undefined;
		}

		if !types.isEmpty() {
			return Value::TypeRef(types[0u], this.ctx.typeref_type);
		} else if !variables.isEmpty() {
			if variables[0u].is_parameter {
				return Value::Register(variables[0u].id, variables[0u].type).addImplicitDereference();
			} else {
				var type = variables[0u].type;
				if type.reference_kind == None {
					type = variables[0u].is_const ? type.constRef() : type.varRef();
				}
				return Value::Variable(variables[0u], type).addImplicitDereference();
			}
		} else if !case_decls.isEmpty() {
			const case_decl = case_decls[0u];
			if case_decl.parent_type.isEnum() {
				return Value::fromPrimitive!<int>(case_decl.id, case_decl.parent_type);
			}

			this.todo("finish compiling of variant-case expressions '" + format(name) + "'", name.loc);
			return Value::Undefined;
		} else {
			return template_parameters[0u];
		}
	}

	func compileBoolLiteralExpr(this: &&Compiler, value: bool, expected_type: TypeRef, loc: Location) => Value {
		return Value::fromPrimitive!<bool>(value, this.ctx.bool_type);
	}

	func compileNumberLiteralExpr(this: &&Compiler, value: ParsedNumber, postfix: String, expected_type: TypeRef, loc: Location) => Value {
		if postfix.isEmpty() {
			if expected_type.isEnum() {
				return Value::fromPrimitive!<int>(value.toInt(), expected_type.id_type);
			} else if expected_type.isInt() && expected_type != this.ctx.bool_type {
				return Value::fromPrimitive!<int>(value.toInt(), expected_type);
			} else if expected_type.isFloat() {
				return Value::fromPrimitive!<f64>(value.toFloat(), expected_type);
			} else if value.isInteger() && !value.contains_decimal_point {
				return Value::fromPrimitive!<int>(value.toInt(), this.ctx.int_type);
			} else {
				return Value::fromPrimitive!<f64>(value.toFloat(), this.ctx.f64_type);
			}
		} else if postfix == "i" {
			return Value::fromPrimitive!<int>(value.toInt(), this.ctx.int_type);
		} else if postfix == "u" {
			return Value::fromPrimitive!<uint>(value.toInt() as uint, this.ctx.uint_type);
		} else if postfix == "b" {
			return Value::fromPrimitive!<byte>(value.toInt() as byte, this.ctx.byte_type);
		} else if postfix == "f" {
			return Value::fromPrimitive!<f64>(value.toFloat(), this.ctx.f64_type);
		} else {
			const type = this.getType(Name(postfix), loc);
			if type.isInt() {
				return Value::fromPrimitive!<int>(value.toInt(), type);
			} else if type.isFloat() {
				return Value::fromPrimitive!<f64>(value.toFloat(), type);
			} else {
				this.error("invalid postfix type (" + type.signature() + ") for number literal", loc);
				return Value::Undefined;
			}
		}
	}

	func compileCharLiteralExpr(this: &&Compiler, value: String, postfix: String, expected_type: TypeRef, loc: Location) => Value {
		if postfix.isEmpty() || postfix == "b" {
			return Value::fromPrimitive!<byte>(value[0u], this.ctx.byte_type);
		} else {
			const type = this.getType(Name(postfix), loc);
			if type.isInt() {
				return Value::fromPrimitive!<int>(value[0u] as int, type);
			} else {
				this.error("invalid char literal postfix (" + postfix + ")", loc);
				return Value::Undefined;
			}
		}
	}

	func compileStringLiteralExpr(this: &&Compiler, value: String, postfix: String, expected_type: TypeRef, loc: Location) => Value {
		if postfix.isEmpty() {
			return Value::Bytes(List!<byte>(value.bytes()), this.ctx.str_type);
		} else {
			this.error("invalid string literal postfix", loc);
			return Value::Undefined;
		}
	}

	func compileMemberAccessExpr(this: &&Compiler, node: &TSNode, expected_type: TypeRef, loc: Location) => Value {
		this.todo("compile member access exprs", loc);
		return Undefined;
	}

	func compileCallExpr(this: &&Compiler, node: &TSNode, loc: Location) => Value {
		const callee_node = ts_node_child_by_field_id(node, TSVoidField::Callee as u16);
		const parameters_node = ts_node_child_by_field_id(node, TSVoidField::Parameters as u16);

		match ts_node_symbol(callee_node) as TSVoidSymbol {
			case Name | NamespaceExpr -> {
				const callee_name = this.checkName(callee_node, false);

				var contains_undefined_parameter = false;
				var parameters = this.compileCallExprParameters(parameters_node, &&contains_undefined_parameter);
				if callee_name.isEmpty() || contains_undefined_parameter {
					return Undefined;
				}

				const parameter_types = this.getCallParameterTypes(parameters, CallKind::Static);
				const candidates = this.lookupFunction(callee_name, TypeRef::null(), parameter_types, true, true, loc);
				if !candidates.isEmpty() {
					if !this.validateFunctionCandidates(candidates, callee_name, parameter_types, loc) {
						return Undefined;
					}
					return this.compileCall(candidates[0u], parameters, CallKind::Static, true, loc);
				}

				this.todo("finish compiling call exprs", loc);

				discard this.validateFunctionCandidates(candidates, callee_name, parameter_types, loc);
				return Undefined;
			}
			case MemberAccessExpr -> {
				const object_node = ts_node_child_by_field_id(callee_node, TSVoidField::Lhs as u16);
				const object = this.compileExpr(object_node, TypeRef::null());
				const member_node = ts_node_child_by_field_id(callee_node, TSVoidField::Rhs as u16);
				const callee_name = this.checkName(member_node, false);

				var contains_undefined_parameter = false;
				var parameters = this.compileCallExprParameters(parameters_node, &&contains_undefined_parameter);
				if object is Undefined || callee_name.isEmpty() || contains_undefined_parameter{
					return Undefined;
				}

				parameters.insert(0u, object);
				const parent_type = object.type;
				const parameter_types = this.getCallParameterTypes(parameters, CallKind::MemberCall);
				const candidates = this.lookupFunction(callee_name, parent_type, parameter_types, true, true, loc);

				if !candidates.isEmpty() {
					if !this.validateFunctionCandidates(candidates, callee_name, parameter_types, loc) {
						return Undefined;
					}
					return this.compileCall(candidates[0u], parameters, CallKind::MemberCall, true, loc);
				}

				this.todo("finish compiling member-call exprs", loc);
				return Undefined;
			}
			default -> {
				const object = this.compileExpr(callee_node, TypeRef::null());
				var contains_undefined_parameter = false;
				var parameters = this.compileCallExprParameters(parameters_node, &&contains_undefined_parameter);
				if object is Undefined || contains_undefined_parameter {
					return Undefined;
				}
				parameters.insert(0u, object);
				return this.compileCall(Name("()"), parameters, CallKind::Operator, true, loc);
			}
		}
	}

	func compileCallExprParameters(this: &&Compiler, node: &TSNode, contains_undefined_parameter: &&bool) => List!<Value> {
		var parameters: List!<Value>;
		for i in 0u32..ts_node_named_child_count(node) {
			const parameter = this.compileExpr(ts_node_named_child(node, i), TypeRef::null());
			parameters.append(parameter);
			if parameter is Undefined {
				contains_undefined_parameter = true;
			}
		}
		return parameters;
	}

	func compileCall(this: &&Compiler, callee_name: Name, parameters: &List!<Value>, call_kind: CallKind, allow_unwrapping: bool, loc: Location) => Value {
		for p in parameters {
			if p is Undefined {
				return Undefined;
			}
		}

		const name = format(callee_name);
		const parameter_types = this.getCallParameterTypes(parameters, call_kind);
		var parent_type = TypeRef::null();
		match call_kind {
			case MemberCall | Operator -> parent_type = parameter_types[0u].base();
			default -> {}
		}

		const allow_unwrapping_this = (name != "constructor") & allow_unwrapping;
		var candidates = this.lookupFunction(callee_name, parent_type, parameter_types, allow_unwrapping_this, allow_unwrapping, loc);

		var negate_result = false;
		var compare_result_zero = false;
		if candidates.isEmpty() && call_kind == Operator && isComparisonOperator(name) {
			if name == "==" {
				candidates = this.lookupFunction(Name("!="), parent_type, parameter_types, allow_unwrapping_this, allow_unwrapping, loc);
				negate_result = true;
			} else if name == "!=" {
				candidates = this.lookupFunction(Name("=="), parent_type, parameter_types, allow_unwrapping_this, allow_unwrapping, loc);
				negate_result = true;
			}

			if candidates.isEmpty() {
				candidates = this.lookupFunction(Name("<=>"), parent_type, parameter_types, allow_unwrapping_this, allow_unwrapping, loc);
				compare_result_zero = true;
			}
		}

		if !this.validateFunctionCandidates(candidates, callee_name, parameter_types, loc) {
			return Undefined;
		}

		const result = this.compileCall(candidates[0u], parameters, call_kind, allow_unwrapping, loc);
		if compare_result_zero {
			var cmp_arguments: List!<Value>;
			cmp_arguments.append(result);
			cmp_arguments.append(Value::fromPrimitive!<int>(0, result.implicitlyDereferencedType()));
			return this.compileCall(Name(name), cmp_arguments, CallKind::Operator, false, loc);
		} else if negate_result {
			const not_arguments = List!<Value>(1u, result);
			return this.compileCall(Name("!"), not_arguments, CallKind::Operator, false, loc);
		} else {
			return result;
		}
	}

	func getCallParameterTypes(this: &&Compiler, parameters: &List!<Value>, call_kind: CallKind) => List!<TypeRef> {
		var parameter_types: List!<TypeRef>;
		parameter_types.grow(parameters.size());

		const is_member_call = call_kind == MemberCall || call_kind == Operator;
		for i in 0u..parameters.size() {
			if parameters[i].is_implicitly_dereferenced {
				if i == 0 && is_member_call {
					// remove implicit dereference but keep the reference kind
					parameter_types.append(parameters[i].type);
				} else {
					// remove implicit dereference and limit reference kind to const
					parameter_types.append(parameters[i].type.constRef());
				}
			} else {
				parameter_types.append(parameters[i].type);
			}
		}

		return parameter_types;
	}

	func isComparisonOperator(name: &String) => bool {
		return name == "==" || name == "!="
			|| name == "<" || name == "<="
			|| name == ">" || name == ">=";
	}

	func compileCall(this: &&Compiler, function: FuncRef, parameters: &List!<Value>, call_kind: CallKind, allow_unwrapping: bool, loc: Location) => Value {
		var final_parameters: List!<Value>;
		for i in 0u..parameters.size() {
			var parameter = parameters[i];
			if parameter.type.decl != function.parameter_types[i].decl {
				parameter = this.compileCall(Name("unwrap"), List!<Value>(1u, parameter), CallKind::MemberCall, false, loc);
			}

			if parameter.is_implicitly_dereferenced {
				if function.parameter_types[i].reference_kind == None && function.parameter_types[i].isPrimitive() {
					parameter = this.applyImplicitDereference(parameter);
				} else {
					parameter.is_implicitly_dereferenced = false;
					if call_kind == Static || i > 0 {
						parameter.type.reference_kind = Const;
					}
				}
			}

			if parameter.type.decl != function.parameter_types[i].decl
			|| parameter.type.reference_kind < function.parameter_types[i].reference_kind {
				this.error("invalid parameter type for call (expected " + function.parameter_types[i].signature() + ", but got " + parameter.type.signature() + ")", loc);
				return Undefined;
			}

			if parameter.type.isPrimitive() {
				final_parameters.append(parameter);
			} else if parameter.type.isPassedByValue(final_parameters.size()) {
				assert(parameter.type.reference_kind != None);
				this.todo("split composite parameter", loc);
			} else {
				assert(parameter.type.reference_kind != None);
				final_parameters.append(parameter);
			}
		}

		var result_variable = Value::Undefined;
		if !function.return_type.isReturnedByValue() {
			const result_variable_decl = this.createLocalVariable("#result", function.return_type, true, false, loc);
			result_variable = Value(result_variable_decl);
			this.deferDestructorCall(result_variable_decl);
			final_parameters.insert(0u, result_variable);
		}

		var result = this.builder.buildCall(function, final_parameters);
		if result.type == this.ctx.never_type {
			discard this.builder.buildUnreachable();
		}

		if !function.return_type.isReturnedByValue() {
			result = result_variable;
		}

		if result.type.reference_kind != None {
			result.is_implicitly_dereferenced = true;
		}

		return result;
	}

	func compileIndexExpr(this: &&Compiler, node: &TSNode, loc: Location) => Value {
		this.todo("compile index exprs", loc);
		return Undefined;
	}

	func compileUnaryExpr(this: &&Compiler, node: &TSNode, expected_type: TypeRef, loc: Location) => Value {
		const op = this.getNodeSource(ts_node_child_by_field_id(node, TSVoidField::Op as u16));
		var operand = this.compileExpr(ts_node_child_by_field_id(node, TSVoidField::Operand as u16), expected_type);

		if op == "&" || op == "&&" {
			if !operand.is_implicitly_dereferenced {
				this.error("can't take reference of another reference", loc);
				return Undefined;
			}

			if op == "&&" && operand.type.reference_kind == Const {
				this.error("can't take mutable reference of constant object", loc);
				return Undefined;
			}

			operand.is_implicitly_dereferenced = false;
			if op == "&" && operand.type.reference_kind == Var {
				operand.type.reference_kind = Const;
			}

			return operand;
		} else if op == "try" || op == "must" {
			this.todo("compile 'try' / 'must' exprs", loc);
			return Undefined;
		} else {
			return this.compileCall(Name(op), List!<Value>(1u, operand), CallKind::Operator, true, loc);
		}
	}

	func compileBinaryExpr(this: &&Compiler, node: &TSNode, expected_type: TypeRef, loc: Location) => Value {
		const op = this.getNodeSource(ts_node_child_by_field_id(node, TSVoidField::Op as u16));

		if op == ":=" {
			this.todo("compile ':=' exprs", loc);
			return Undefined;
		} else if op == "is" {
			this.todo("compile 'is' exprs", loc);
			return Undefined;
		} else if op == "as" {
			this.todo("compile 'as' exprs", loc);
			return Undefined;
		} else if op == "&&" || op == "||" {
			this.todo("compile '&&' / '||' exprs", loc);
			return Undefined;
		} else {
			var operands: List!<Value>;
			operands.append(this.compileExpr(ts_node_child_by_field_id(node, TSVoidField::Lhs as u16), expected_type));
			operands.append(this.compileExpr(ts_node_child_by_field_id(node, TSVoidField::Rhs as u16), expected_type));
			return this.compileCall(Name(op), operands, CallKind::Operator, true, loc);
		}
	}

	func compileInlineIfExpr(this: &&Compiler, node: &TSNode, expected_type: TypeRef, loc: Location) => Value {
		this.todo("compile inline if exprs", loc);
		return Undefined;
	}

	func compileTupleExpr(this: &&Compiler, node: &TSNode, expected_type: TypeRef, loc: Location) => Value {
		if ts_node_symbol(node) as TSVoidSymbol == TupleExpr && ts_node_named_child_count(node) == 1 && !expected_type.isTuple() {
			return this.compileExpr(ts_node_named_child(node, 0u32), expected_type);
		}

		this.todo("compile tuple exprs", loc);
		return Undefined;
	}

	func compileArrayExpr(this: &&Compiler, node: &TSNode, expected_type: TypeRef, loc: Location) => Value {
		this.todo("compile array exprs", loc);
		return Undefined;
	}

	func compileDictExpr(this: &&Compiler, node: &TSNode, expected_type: TypeRef, loc: Location) => Value {
		this.todo("compile dict exprs", loc);
		return Undefined;
	}

	func compileMatchExpr(this: &&Compiler, node: &TSNode, expected_type: TypeRef, loc: Location) => Value {
		this.todo("compile match exprs", loc);
		return Undefined;
	}

	func compileAnonymousFunctionExpr(this: &&Compiler, node: &TSNode, loc: Location) => Value {
		this.todo("compile anonymous function exprs", loc);
		return Undefined;
	}

	func compileFunctionReferenceExpr(this: &&Compiler, node: &TSNode, loc: Location) => Value {
		this.todo("compile function reference exprs", loc);
		return Undefined;
	}

	func applyImplicitDereference(this: &&Compiler, value: &Value) => Value {
		if value.is_implicitly_dereferenced {
			return this.builder.buildLoad(value.type.base(), value);
		} else {
			return value;
		}
	}

	func compileScopedExpr(this: &&Compiler, node: &TSNode, expected_type: TypeRef) => (value: Value, region: RegionRef) {
		const prev_block = this.builder.getInsertBlock();
		const region = this.current_function.createRegion();
		this.builder.setInsertPointToEnd(region);
		const result = this.applyImplicitDereference(this.compileExpr(node, expected_type));
		this.builder.setInsertPointToEnd(prev_block);
		return (value: result, region: region);
	}

	func compileComptimeExpr(this: &&Compiler, node: &TSNode, expected_type: TypeRef) => SharedPtr!<FunctionDecl> {
		var function = SharedPtr!<FunctionDecl>::new();
		function.parent_namespace = this.current_namespace;
		function.loc = this.getNodeSpan(node);
		function.signature_span = function.loc;
		function.is_comptime = true;

		this.pushGlobalScope(function.parent_namespace, function.getRef());
		const result = this.compileExpr(node, expected_type);
		function.return_type = result.implicitlyDereferencedType();
		discard this.builder.buildReturn(result);
		this.popGlobalScope();

		return function;
	}

	func interpretComptimeExpr(this: &&Compiler, function: SharedPtr!<FunctionDecl>) => Value {
		return this.interpreter.interpretCall(function.getRef(), List!<Value>());
	}

	func interpretComptimeExpr(this: &&Compiler, node: &TSNode, expected_type: TypeRef) => Value {
		return this.interpretComptimeExpr(this.compileComptimeExpr(node, expected_type));
	}
}

func format(types: &List!<TypeRef>) => String {
	var result = "(";
	for i in 0u..types.size() {
		if i != 0 {
			result += ", ";
		}

		result += types[i].signature();
	}

	return result + ")";
}
