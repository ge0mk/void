	func matchAddCase(this: &&Builder, id: uint, value: &Value, body: RegionRef) => void {
		var instruction = &&this.function.instructions[id];
		assert(instruction.op == OpCode::Match);
		assert(value.type == this.ctx.int_type);
		instruction.operands.append(value);
		instruction.operands.append(Value::RegionRef(body));
	}

	func switchAddCase(this: &&Builder, id: uint, value: &Value, block: BlockRef) => void {
		var instruction = &&this.function.instructions[id];
		assert(instruction.op == OpCode::Switch);
		assert(value.type == this.ctx.int_type);
		instruction.operands.append(value);
		instruction.operands.append(Value::BlockRef(block));
	}

	func phiAddIncoming(this: &&Builder, id: uint, block: BlockRef, value: &Value) => void {
		var instruction = &&this.function.instructions[id];
		assert(instruction.op == OpCode::Phi);
		assert(value.type == instruction.result_type);
		instruction.operands.append(Value::BlockRef(block));
		instruction.operands.append(value);
	}

	func replaceAllUsesWith(this: &&Builder, register: uint, value: &Value) => void {
		for &&instruction in this.function.instructions {
			for &&operand in instruction.operands {
				match operand {
					case Register: index -> {
						if index == register {
							operand = value;
						}
					}
					default -> {}
				}
			}
		}
	}

	func runConversionPasses(this: &&Builder, passes: Map!<OpCode, (&&Builder, Instruction) => void>) => void {
		var index = 0u;
		while index < this.function.instructions.size() {
			while passes.contains(this.function.instructions[index].op) {
				const instruction = this.function.instructions[index];
				passes.get(instruction.op).value()(&&this, this.function.instructions[index]);
				assert(instruction.op != this.function.instructions[index].op);
			}
			index++;
		}
	}

	func insertRegionIntoBlock(this: &&Builder, block: BlockRef, index: uint, region: RegionRef) => void {
		if region.blocks.isEmpty() {
			return;
		} else if region.blocks.size() == 1u {
			block.insertInstructions(index, (&region.blocks.front().instructions).range());
		} else {
			const offset = block.region.getBlockOffset(block.getRef()) + 1;
			var tail = block.split(index);

			block.insertInstructions(index, (&region.blocks.front().instructions).range());
			this.setInsertPointToEnd(region.blocks.back());
			discard this.buildBranch(tail);

			block.region.insertBlocks(offset, (&region.blocks)[1u..region.blocks.size()]);

			// todo: update predecessors & successors
		}
	}
}
