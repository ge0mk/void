import std/core;
import std/io;
import std/list;
import std/libc/stdlib;
import std/path;
import std/string;

import args;
import builtins;
import compiler;
import ir;
import llvm_c;
import options;

func parseArguments(arguments: Range!<String, false>) => Optional!<CompilerOptions> {
	var args_parser = ArgsParser(arguments, "");
	var options: CompilerOptions;

	var subcommands: List!<String>;
	subcommands.append("compile");
	subcommands.append("check");
	subcommands.append("run");

	options.mode = (args_parser.subcommand(Range!<String, false>(subcommands.range())) ?? 0u) as Mode;

	options.dump_ir = args_parser.flag("d", "dump-ir", "dump ir") ?? false;

	options.hide_errors = args_parser.flag("q", "hide_errors", "do not display error messages") ?? false;

	options.program_name = args_parser.value("o", "ctx-name", "ctx name & output file name") ?? "";
	options.build_dir = args_parser.value("B", "build-dir", "build dir & output file location") ?? "build";

	// TODO: replace default values with host platform specific ones
	options.target_triple = args_parser.value("", "target-triple", "target triple string passed to llvm") ?? "x86_64-pc-linux-gnu";
	options.target_data_layout = args_parser.value("", "target-data-layout", "target data layout string passed to llvm") ?? "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128";
	options.codegen_only = args_parser.flag("c", "codegen-only", "don't compile output code to a binary") ?? false;
	options.generate_debug_info = args_parser.flag("g", "generate-debug-info", "generate debug information") ?? false;
	options.codegen_inline_builtin_functions = !(args_parser.flag("m", "cg-no-builtins", "don't codegen inlineable builtin functions") ?? false);

	options.codegen_lazy = args_parser.flag("M", "cg-lazy", "codegen functions lazily as needed") ?? false;
	options.codegen_asap = !(options.codegen_lazy || options.mode == Check);

	const optimization_level = args_parser.value("O", "optimization-level", "enable optimizations") ?? "0";
	if optimization_level == "1" {
		options.optimization_level = 1;
	} else if optimization_level == "2" {
		options.optimization_level = 2;
	} else if optimization_level == "3" {
		options.optimization_level = 3;
	} else if optimization_level == "s" {
		options.optimization_level = 4;
	} else if optimization_level == "z" {
		options.optimization_level = 5;
	}

	if args_parser.flag("s", "strip-symbols", "strip symbols") ?? false {
		options.symbol_type = None;
	}

	if args_parser.flag("b", "bitcode", "generate llvm bitcode") ?? false {
		options.output_type = LLVMBitcode;
	}

	if args_parser.flag("S", "emit-llvm", "generate llvm ir") ?? false {
		options.output_type = LLVMAssembly;
	}

	var library = args_parser.value("l", "link-library", "library to link against");
	while library.hasValue() {
		options.link_libraries.append(library.value());
		library = args_parser.value("l", "link-library", "library to link against");
	}

	match args_parser.anonymous("path to the root module file") {
		case Some: value -> options.root_module_path = value;
		default -> {
			eprintln("no root module specified");
			return None;
		}
	}

	options.secondary_args = args_parser.getArgsAfterSeparator();

	const path = options.root_module_path;
	if !path.endsWith(".vd") || path.size() <= 3 {
		eprintln("invalid source file");
		return None;
	}

	if options.program_name == "" {
		var name_begin: uint;
		match path.rfind('/'b) {
			case Some: index -> name_begin = index + 1;
			default -> name_begin = 0;
		}

		const name_end = path.rfind('.'b) ?? path.size();
		options.program_name = path.substring(name_begin..name_end);
	}

	options.install_path = ".";
	const compiler_binary_path = Path::getExePath();
	if const compiler_binary_dir = compiler_binary_path.parentDir() {
		if const compiler_install_dir = compiler_binary_dir.parentDir() {
			options.import_search_paths.append(compiler_install_dir);
			options.install_path = compiler_install_dir.toString();
		}
	}

	options.import_search_paths.append(Path::cwd());

	const absolute_root_module_path = Path::cwd() / Path(options.root_module_path);
	if const root_module_dir = absolute_root_module_path.parentDir() {
		options.import_search_paths.append(root_module_dir);
	}

	return Some(options);
}

func main(args: Range!<String, false>) => int {
	defer LLVMShutdown();

	const options = parseArguments(args) else {
		return 1;
	}

	if !Path(options.build_dir).isDirectory() {
		const mkdir_cmd = "mkdir -p " + options.build_dir + '\0'b;
		discard system(mkdir_cmd.data());
	}

	var compiler: Compiler = (options);

	compiler.registerPragma("generate_std_core_builtins", func (this: &&Compiler, ctx: &&Context, ns: NamespaceRef, loc: Location) => void {
		ctx.core_namespace = ns;

		ctx.any_concept = ctx.createConcept(ConceptDecl::Any(ctx.getRef(), "type"));
		ctx.bool_concept = ctx.createConcept(ConceptDecl::Boolean(ctx.getRef(), "bool"));
		ctx.int_concept = ctx.createConcept(ConceptDecl::Integer(true, ctx.getRef(), "int"));
		ctx.uint_concept = ctx.createConcept(ConceptDecl::Integer(false, ctx.getRef(), "uint"));
		ctx.string_concept = ctx.createConcept(ConceptDecl::String(ctx.getRef(), "str"));

		ctx.createPrimitiveCastTemplates(ns);
		ctx.createCoreReflectionFunctionTemplates(ns);
		const int_template = ctx.createIntTypeTemplate(ns);
		const ptr_template = ctx.createPtrTypeTemplate(ns);
/*
		discard ctx.createFunctionTypeTemplate(ns);
		discard ctx.createArrayTypeTemplate(ns);
		discard ctx.createTupleTypeTemplate(ns);
		discard ctx.createRangeTypeTemplate(ns);
		discard ctx.createRangeIteratorTypeTemplate(ns);
		discard ctx.createNumericRangeTypeTemplate(ns);
*/
		ctx.void_type = ctx.createVoidType(ns);
		ctx.never_type = ctx.createNeverType(ns);

		ctx.bool_type = ctx.createBoolType(ns);

		ctx.int_type = this.createTypeTemplateInstance!<2u>(int_template, [
			Value::Undefined,
			Value::fromPrimitive!<bool>(true, ctx.bool_type)
		], loc);
		ctx.createTypeAlias(ns, "int", ctx.int_type);

		ctx.uint_type = this.createTypeTemplateInstance!<2u>(int_template, [
			Value::Undefined,
			Value::fromPrimitive!<bool>(false, ctx.bool_type)
		], loc);
		ctx.createTypeAlias(ns, "uint", ctx.uint_type);

		ctx.byte_type = ctx.createByteType(ns);

		ctx.typeref_type = ctx.createTypeRefType(ns);
		ctx.funcref_type = ctx.createFuncRefType(ns);

		ctx.i32_type = this.createTypeTemplateInstance!<2u>(int_template, [
			Value::fromPrimitive!<int>(32, ctx.int_type),
			Value::fromPrimitive!<bool>(true, ctx.bool_type)
		], loc);

		ctx.error_type = ctx.createErrorType(ns, ctx.i32_type);

		ctx.ptr_type = this.createTypeTemplateInstance!<2u>(ptr_template, [
			Value::TypeRef(ctx.void_type, ctx.typeref_type),
			Value::fromPrimitive!<bool>(true, ctx.bool_type)
		], loc);

		ctx.exit_function = ctx.createExternFunction!<1u>(ns, "exit", [ctx.int_type], ctx.never_type, "exit");
		ctx.abort_function = ctx.createExternFunction(ns, "abort", List!<TypeRef>(), ctx.never_type, "abort");
		ctx.panic_function = ctx.createExternFunction!<1u>(ns, "panic", [ctx.error_type], ctx.never_type, "panic");
		ctx.assert_function = ctx.createInlineFunction!<1u>(ns, "assert", [ctx.bool_type], ctx.void_type, OpCode::Assert, 0u32, TypeRef::null());
		ctx.assert_error_function = ctx.createInlineFunction!<2u>(ns, "assert", [ctx.bool_type, ctx.error_type], ctx.void_type, OpCode::AssertError, 0u32, TypeRef::null());

		discard ctx.createInlineFunction(ns, "swap", List!<TemplateParameterDecl>(1u, TemplateParameterDecl("Type", ctx.any_concept, false)), OpCode::Swap, 0u32, TypeRef::null());

		discard ctx.createFloatType(ns, FloatType::F16);
		discard ctx.createFloatType(ns, FloatType::Bf16);
		discard ctx.createFloatType(ns, FloatType::F32);
		ctx.f64_type = ctx.createFloatType(ns, FloatType::F64);
		discard ctx.createFloatType(ns, FloatType::F128);
	});

	compiler.registerPragma("generate_std_math_builtins", func (this: &&Compiler, ctx: &&Context, ns: NamespaceRef, loc: Location) => void {
/*
		const one_type_template_parameters = List!<TemplateParameterDecl>(1u, TemplateParameterDecl("Type", ctx.any_concept, false));

		discard ctx.createFunction(ns, "abs", one_type_template_parameters, BuiltinFunction::PrimitiveOp(PrimitiveOp::Abs, Type::unknown()));
		discard ctx.createFunction(ns, "sign", one_type_template_parameters, BuiltinFunction::PrimitiveOp(PrimitiveOp::Sign, Type::unknown()));

		discard ctx.createFunction(ns, "min", one_type_template_parameters, BuiltinFunction::PrimitiveOp(PrimitiveOp::Min, Type::unknown()));
		discard ctx.createFunction(ns, "max", one_type_template_parameters, BuiltinFunction::PrimitiveOp(PrimitiveOp::Max, Type::unknown()));
		discard ctx.createFunction(ns, "clamp", one_type_template_parameters, BuiltinFunction::PrimitiveOp(PrimitiveOp::Clamp, Type::unknown()));
		discard ctx.createFunction(ns, "lerp", one_type_template_parameters, BuiltinFunction::PrimitiveOp(PrimitiveOp::Lerp, Type::unknown()));

		discard ctx.createFunction(ns, "sqrt", one_type_template_parameters, BuiltinFunction::PrimitiveOp(PrimitiveOp::Sqrt, Type::unknown()));
		discard ctx.createFunction(ns, "isqrt", one_type_template_parameters, BuiltinFunction::PrimitiveOp(PrimitiveOp::ISqrt, Type::unknown()));
		discard ctx.createFunction(ns, "pow", one_type_template_parameters, BuiltinFunction::PrimitiveOp(PrimitiveOp::Pow, Type::unknown()));
		discard ctx.createFunction(ns, "exp", one_type_template_parameters, BuiltinFunction::PrimitiveOp(PrimitiveOp::Exp, Type::unknown()));
		discard ctx.createFunction(ns, "exp2", one_type_template_parameters, BuiltinFunction::PrimitiveOp(PrimitiveOp::Exp2, Type::unknown()));
		discard ctx.createFunction(ns, "exp10", one_type_template_parameters, BuiltinFunction::PrimitiveOp(PrimitiveOp::Exp10, Type::unknown()));
		discard ctx.createFunction(ns, "log", one_type_template_parameters, BuiltinFunction::PrimitiveOp(PrimitiveOp::Log, Type::unknown()));
		discard ctx.createFunction(ns, "log2", one_type_template_parameters, BuiltinFunction::PrimitiveOp(PrimitiveOp::Log2, Type::unknown()));
		discard ctx.createFunction(ns, "log10", one_type_template_parameters, BuiltinFunction::PrimitiveOp(PrimitiveOp::Log10, Type::unknown()));

		discard ctx.createFunction(ns, "floor", one_type_template_parameters, BuiltinFunction::PrimitiveOp(PrimitiveOp::Floor, Type::unknown()));
		discard ctx.createFunction(ns, "ceil", one_type_template_parameters, BuiltinFunction::PrimitiveOp(PrimitiveOp::Ceil, Type::unknown()));
		discard ctx.createFunction(ns, "fract", one_type_template_parameters, BuiltinFunction::PrimitiveOp(PrimitiveOp::Fract, Type::unknown()));
		discard ctx.createFunction(ns, "round", one_type_template_parameters, BuiltinFunction::PrimitiveOp(PrimitiveOp::Round, Type::unknown()));
		discard ctx.createFunction(ns, "roundEven", one_type_template_parameters, BuiltinFunction::PrimitiveOp(PrimitiveOp::RoundEven, Type::unknown()));

		discard ctx.createFunction(ns, "sin", one_type_template_parameters, BuiltinFunction::PrimitiveOp(PrimitiveOp::Sin, Type::unknown()));
		discard ctx.createFunction(ns, "cos", one_type_template_parameters, BuiltinFunction::PrimitiveOp(PrimitiveOp::Cos, Type::unknown()));
		discard ctx.createFunction(ns, "tan", one_type_template_parameters, BuiltinFunction::PrimitiveOp(PrimitiveOp::Tan, Type::unknown()));
		discard ctx.createFunction(ns, "sinh", one_type_template_parameters, BuiltinFunction::PrimitiveOp(PrimitiveOp::SinH, Type::unknown()));
		discard ctx.createFunction(ns, "cosh", one_type_template_parameters, BuiltinFunction::PrimitiveOp(PrimitiveOp::CosH, Type::unknown()));
		discard ctx.createFunction(ns, "tanh", one_type_template_parameters, BuiltinFunction::PrimitiveOp(PrimitiveOp::TanH, Type::unknown()));
		discard ctx.createFunction(ns, "asin", one_type_template_parameters, BuiltinFunction::PrimitiveOp(PrimitiveOp::ASin, Type::unknown()));
		discard ctx.createFunction(ns, "acos", one_type_template_parameters, BuiltinFunction::PrimitiveOp(PrimitiveOp::ACos, Type::unknown()));
		discard ctx.createFunction(ns, "atan", one_type_template_parameters, BuiltinFunction::PrimitiveOp(PrimitiveOp::ATan, Type::unknown()));
		discard ctx.createFunction(ns, "asinh", one_type_template_parameters, BuiltinFunction::PrimitiveOp(PrimitiveOp::ASinH, Type::unknown()));
		discard ctx.createFunction(ns, "acosh", one_type_template_parameters, BuiltinFunction::PrimitiveOp(PrimitiveOp::ACosH, Type::unknown()));
		discard ctx.createFunction(ns, "atanh", one_type_template_parameters, BuiltinFunction::PrimitiveOp(PrimitiveOp::ATanH, Type::unknown()));

		ctx.createVectorTypeTemplate(ns);
		ctx.createMatrixTypeTemplate(ns);

		var matmul_template_parameters: List!<TemplateParameterDecl>;
		matmul_template_parameters.append(TemplateParameterDecl("Type", ctx.any_concept, false));
		matmul_template_parameters.append(TemplateParameterDecl("AColumns", ctx.uint_concept, false));
		matmul_template_parameters.append(TemplateParameterDecl("ARows", ctx.uint_concept, false));
		matmul_template_parameters.append(TemplateParameterDecl("BColumns", ctx.uint_concept, false));
		discard ctx.createFunction(ns, "matmul", matmul_template_parameters, BuiltinFunction::MatrixMultiply((a_columns: 0u, a_rows: 0u, b_columns: 0u), Type::unknown()));
*/
	});

	compiler.registerPragma("finalize_std_core_array_instance", func (this: &&Compiler, ctx: &&Context, ns: NamespaceRef, loc: Location) => void {
/*
		const type = Type(ns.linked_type);
		const element_type = (ns.linked_type.body as Array).value().element_type;

		const element_ptr_type_template_parameters = List!<TemplateParameter>(1u, TemplateParameter::Type(element_type));

		const element_cptr_type = this.getType(Name("ptr", element_ptr_type_template_parameters + TemplateParameter::Boolean(false)), Location(), false);
		const element_vptr_type = this.getType(Name("ptr", element_ptr_type_template_parameters + TemplateParameter::Boolean(true)), Location(), false);

		discard ctx.createUnaryFunction(ns, "data", type.constRef(), element_cptr_type, BuiltinFunction::ArrayGetDataPointer(type));
		discard ctx.createUnaryFunction(ns, "data", type.varRef(), element_vptr_type, BuiltinFunction::ArrayGetDataPointer(type));
*/
	});

	compiler.registerPragma("finalize_std_math_matrix_instance", func (this: &&Compiler, ctx: &&Context, ns: NamespaceRef, loc: Location) => void {
/*
		const type = Type(ns.linked_type);
		const matrix_type = (ns.linked_type.body as Matrix).value();
		const transposed_type = this.getMatrixType(matrix_type.element_type, matrix_type.rows, matrix_type.columns, loc);
		const column_vector_type = this.getVectorType(matrix_type.element_type, matrix_type.rows, loc);
		const row_vector_type = this.getVectorType(matrix_type.element_type, matrix_type.columns, loc);

		discard ctx.createFunction(ns, "fromColumns", List!<Type>(matrix_type.columns, column_vector_type), type, BuiltinFunction::PrimitiveOp(PrimitiveOp::MatrixFromColumns, type));
		discard ctx.createFunction(ns, "fromRows", List!<Type>(matrix_type.rows, row_vector_type), type, BuiltinFunction::PrimitiveOp(PrimitiveOp::MatrixFromRows, type));

		discard ctx.createFunction(ns, "transpose", List!<Type>(1u, type), transposed_type, BuiltinFunction::PrimitiveOp(PrimitiveOp::MatrixTranspose, type));
*/
	});

	return compiler.run();
}
